@page "/refuels/add"
@rendermode InteractiveServer

@using FuelControl.Components.Pages.FuelingRecord.Dialogs
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Services.Interfaces
@using FuelControl.Omnicomm.Reports.Models

@inject IFuelingRecordService FuelingRecordService
@inject IFuelTruckService FuelTruckService
@inject IVehicleService VehicleService
@inject IOperatorService OperatorService
@inject ITimeZoneService TimeZoneService
@inject IFuelingUssService FuelingUssService
@inject IOmnicommSpeedService OmnicommSpeedService
@inject IBrowserTimeZoneService BrowserTimeZoneService

<PageTitle>Заправки</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Заправки
        </h3>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!CanAddFuelingRecord)"
                @onclick="OpenCreateDialog">

            <i class="bi bi-plus-lg me-1"></i>

            Добавить заправку
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <!-- Фильтр -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Топливозаправщик
                    </label>

                    <select class="form-select"
                            value="@_selectedFuelTruckId"
                            @onchange="OnFuelTruckChanged">

                        <option value="@Guid.Empty">
                            Выберите топливозаправщик
                        </option>

                        @foreach (var fuelTruck in _fuelTrucks)
                        {
                            <option value="@fuelTruck.Id">
                                @GetFuelTruckName(fuelTruck)
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Дата
                    </label>

                    <input type="date"
                           class="form-control"
                           value="@_selectedDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" />

                </div>

            </div>

        </div>

    </div>

    <!-- Список заправок -->

    <div class="card">

        <div class="card-body p-0">

            @if (_isLoading)
            {
                <div class="p-4 text-center">

                    <div class="spinner-border"
                         role="status">

                        <span class="visually-hidden">
                            Загрузка...
                        </span>

                    </div>

                </div>
            }
            else if (_selectedFuelTruckId == Guid.Empty)
            {
                <div class="p-4 text-center text-muted">
                    Выберите топливозаправщик.
                </div>
            }
            else if (_fuelingRecords.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    За выбранную дату заправок нет.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Время
                                </th>

                                <th>
                                    Техника
                                </th>

                                <th>
                                    Водитель
                                </th>

                                <th>
                                    Начальные показания
                                </th>

                                <th>
                                    Конечные показания
                                </th>

                                <th>
                                    Объём, л
                                </th>

                                <th>
                                    Показания УСС
                                </th>

                                <th>
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var record in _fuelingRecords)
                            {
                                <tr>

                                    <td>
                                        @FormatLocalDateTime(
                                            record.FuelingDateTime)
                                    </td>

                                    <td>
                                        @record.Vehicle?.Name
                                    </td>

                                    <td>
                                        @record.Operator?.FullName
                                    </td>

                                    <td>
                                        @record.CounterStart
                                    </td>

                                    <td>
                                        @record.CounterEnd
                                    </td>

                                    <td>
                                        @record.Volume
                                    </td>

                                    <td>
                                        @GetUssDisplayText(record.Id)
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenEditDialog(record)">
                                            <span class="bi bi-pencil"></span>
                                            Изменить
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => OpenDeleteDialog(record)">
                                            <span class="bi bi-trash"></span>
                                            Удалить
                                        </button>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- Диалог выбора техники -->

<VehicleSelectDialog
    Visible="@_showVehicleDialog"
    Vehicles="@_vehicles"
    SelectedVehicleId="@_dialogVehicleId"
    OnSelected="@OnVehicleSelected"
    OnClosed="@CloseVehicleDialog" />


<!-- Диалог выбора водителя -->

<OperatorSelectDialog
    Visible="@_showOperatorDialog"
    Operators="@_operators"
    SelectedOperatorId="@_dialogOperatorId"
    OnSelected="@OnOperatorSelected"
    OnClosed="@CloseOperatorDialog" />

    
<UssSelectDialog Visible="@_showUssDialog"
                 Loading="@_isLoadingSpeed"
                 Events="@_ussEvents"
                 SpeedReport="@_speedReport"
                 SelectedEventIds="@_selectedUssEventIds"
                 AttachedEventIds="@GetAttachedUssEventIds()"
                 OnSelected="@OnUssSelected"
                 OnClosed="@CloseUssDialog" />

<!-- Диалог добавления / редактирования -->

@if (_showDialog)
{
    <div class="modal fade show d-block fueling-record-modal"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

    <div class="modal-dialog modal-lg modal-dialog-centered">

    <div class="modal-content">

    <div class="modal-header">

        <h5 class="modal-title">

            @(_editingRecord is null
                ? "Добавление заправки"
                : "Редактирование заправки")

        </h5>

        <button type="button"
                class="btn-close"
                @onclick="CloseDialog">
        </button>

    </div>

    <div class="modal-body">

        <div class="row g-3">

            <!-- Дата -->

            <div class="col-md-6">

                <label class="form-label">
                    Дата
                </label>

                <input type="date"
                       class="form-control"
                       @bind="_dialogDate" />

            </div>


            <!-- Время -->

            <div class="col-md-6">

                <label class="form-label">
                    Время
                </label>

                <input type="time"
                       class="form-control"
                       @bind="_dialogTime" />

            </div>


            <!-- Техника -->

            <div class="col-md-12">

                <label class="form-label">
                    Техника
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                           value="@GetSelectedVehicleName()"
                           placeholder="Техника не выбрана" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenVehicleDialog">

                        Выбрать

                    </button>

                </div>

            </div>


            <!-- Водитель -->

            <div class="col-md-12">

                <label class="form-label">
                    Водитель
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                           value="@GetSelectedOperatorName()"
                           placeholder="Водитель не выбран" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenOperatorDialog">

                        Выбрать

                    </button>

                </div>

            </div>


            <!-- Счётчик -->

            <div class="col-md-4">

                <label class="form-label">
                    Начальные показания
                </label>

                <input type="number"
                       class="form-control"
                       min="0"
                       @bind="_dialogCounterStart" />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Конечные показания
                </label>

                <input type="number"
                       class="form-control"
                       min="0"
                       @bind="_dialogCounterEnd" />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Объём, л
                </label>

                <input type="number"
                       class="form-control"
                       min="1"
                       @bind="_dialogVolume" />

            </div>


            <!-- УСС -->

            <div class="col-md-12">

                <label class="form-label">
                    Показания УСС
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                                       value="@GetUssSelectionText(_editingRecord?.Id)"
                           placeholder="Показания УСС не выбраны" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@(!CanSelectUss)"
                            @onclick="OpenUssDialog">

                        Выбрать показания УСС

                    </button>

                </div>

            </div>

        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                @onclick="CloseDialog">

            Отмена

        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!CanSave)"
                @onclick="SaveAsync">

            Сохранить

        </button>

    </div>

    </div>

    </div>

    </div>
}
@if (_showDeleteDialog && _recordToDelete is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Подтверждение удаления
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDeleteDialog">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-3">
                        Вы действительно хотите удалить эту заправку?
                    </p>

                    <div class="border rounded p-3">

                        <div>
                            <strong>Дата:</strong>
                            @FormatLocalDateTime(
                                _recordToDelete.FuelingDateTime)
                        </div>

                        <div>
                            <strong>Техника:</strong>
                            @_recordToDelete.Vehicle?.Name
                        </div>

                        <div>
                            <strong>Водитель:</strong>
                            @_recordToDelete.Operator?.FullName
                        </div>

                        <div>
                            <strong>Объём:</strong>
                            @_recordToDelete.Volume л
                        </div>

                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        После удаления восстановить запись будет невозможно.
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDeleteDialog">

                        Отмена

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDeleteAsync">

                        <i class="bi bi-trash me-1"></i>

                        Удалить

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {
    private OmnicommSpeedReport? _speedReport;

    private bool _isLoadingSpeed;
    private OmnicommTimeZone? _browserTimeZone;
    private bool _showDeleteDialog;
    private bool _showUssDialog;

    private List<OmnicommDeliveryEvent> _ussEvents = [];

    private HashSet<int> _selectedUssEventIds = [];
    private FuelControl.Domain.Entities.FuelingRecord? _recordToDelete;
    private readonly List<FuelTruck> _fuelTrucks = [];
    private readonly List<Vehicle> _vehicles = [];
    private readonly List<Operator> _operators = [];

    private List<FuelControl.Domain.Entities.FuelingRecord> _fuelingRecords = [];

    private Guid _selectedFuelTruckId = Guid.Empty;

    private DateOnly _selectedDate =
        DateOnly.FromDateTime(DateTime.Now);

    private bool _isLoading;

    private string? _errorMessage;

    private bool _showDialog;
    private bool _showVehicleDialog;
    private bool _showOperatorDialog;

    private FuelControl.Domain.Entities.FuelingRecord? _editingRecord = null;

    private DateOnly _dialogDate;

    private TimeOnly _dialogTime;

    private Guid? _dialogVehicleId;

    private Guid? _dialogOperatorId;

    private int _dialogCounterStart;

    private int _dialogCounterEnd;

    private int _dialogVolume;
    private bool _ussSelectionInitialized;

    private List<FuelingUssRecord> _selectedUssRecords = [];


    private bool CanAddFuelingRecord =>
        _selectedFuelTruckId != Guid.Empty;


    private bool CanSelectUss =>
        _selectedFuelTruckId != Guid.Empty
        && _dialogVehicleId.HasValue;


    private bool CanSave =>
        _selectedFuelTruckId != Guid.Empty
        && _dialogVehicleId.HasValue
        && _dialogOperatorId.HasValue
        && _dialogVolume > 0
        && _dialogCounterStart >= 0
        && _dialogCounterEnd >= _dialogCounterStart;


    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
    }


    private async Task LoadReferenceDataAsync()
    {
        _fuelTrucks.Clear();

        _fuelTrucks.AddRange(
            await FuelTruckService.GetAllAsync());


        _vehicles.Clear();

        _vehicles.AddRange(
            await VehicleService.GetAllAsync());


        _operators.Clear();

        _operators.AddRange(
            await OperatorService.GetAllAsync());
    }


    private async Task OnFuelTruckChanged(
        ChangeEventArgs args)
    {
        _errorMessage = null;

        if (Guid.TryParse(
                args.Value?.ToString(),
                out var id))
        {
            _selectedFuelTruckId = id;
        }
        else
        {
            _selectedFuelTruckId = Guid.Empty;
        }

        await LoadFuelingRecordsAsync();
    }


    private async Task OnDateChanged(
        ChangeEventArgs args)
    {
        _errorMessage = null;

        if (DateOnly.TryParse(
                args.Value?.ToString(),
                out var date))
        {
            _selectedDate = date;
        }

        await LoadFuelingRecordsAsync();
    }


    private async Task LoadFuelingRecordsAsync()
    {
        if (_selectedFuelTruckId == Guid.Empty)
        {
            _fuelingRecords = [];
            return;
        }

        _isLoading = true;

        try
        {
            var timeZone =
                TimeZoneService.GetCurrentTimeZone();

            _fuelingRecords = (
                await FuelingRecordService.GetAllAsync(
                    _selectedDate,
                    timeZone,
                    _selectedFuelTruckId,
                    CancellationToken.None))
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _fuelingRecords = [];
        }
        finally
        {
            _isLoading = false;
        }
    }


    private void OpenCreateDialog()
    {
        if (_selectedFuelTruckId == Guid.Empty)
        {
            _errorMessage =
                "Сначала выберите топливозаправщик.";

            return;
        }

        _errorMessage = null;

        _editingRecord = null;

        _dialogDate = _selectedDate;

        _dialogTime =
            TimeOnly.FromDateTime(DateTime.Now);

        _dialogVehicleId = null;

        _dialogOperatorId = null;

        _dialogCounterStart = 0;

        _dialogCounterEnd = 0;

        _dialogVolume = 0;

        _selectedUssRecords = [];
        _ussSelectionInitialized = true;
        _showDialog = true;
        _speedReport = null;
        _selectedUssEventIds = [];
        _ussEvents = [];
        _isLoadingSpeed = false;
    }

    private IReadOnlyList<FuelingUssRecord> GetSavedUssRecords()
    {
        if (_editingRecord is null)
            return [];

        return _fuelingRecords
                   .FirstOrDefault(x => x.Id == _editingRecord.Id)?
                   .UssRecords
                   .ToList()
               ?? [];
    }

    private IReadOnlySet<int> GetAttachedUssEventIds()
    {
        var currentFuelingRecordId = _editingRecord?.Id;

        return _fuelingRecords
            .Where(x =>
                !currentFuelingRecordId.HasValue ||
                x.Id != currentFuelingRecordId.Value)
            .SelectMany(x => x.UssRecords)
            .Select(x => x.OmnicommEventId)
            .ToHashSet();
    }

    private async Task OpenEditDialog(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        _editingRecord = record;

        var localDateTime =
            TimeZoneService.ToLocal(
                record.FuelingDateTime);

        _dialogDate =
            DateOnly.FromDateTime(
                localDateTime.DateTime);

        _dialogTime =
            TimeOnly.FromDateTime(
                localDateTime.DateTime);

        _dialogVehicleId =
            record.VehicleId;

        _dialogOperatorId =
            record.OperatorId;

        _dialogCounterStart =
            record.CounterStart;

        _dialogCounterEnd =
            record.CounterEnd;

        _dialogVolume =
            record.Volume;

        _selectedUssRecords = [];
        var ussRecords =
            await FuelingUssService.GetByFuelingRecordIdAsync(
                record.Id,
                CancellationToken.None);

        _selectedUssEventIds =
            ussRecords
                .Select(x => x.OmnicommEventId)
                .ToHashSet();
        _ussSelectionInitialized = true;
        _showDialog = true;
    }


    private void CloseDialog()
    {
        _showDialog = false;

        _editingRecord = null;

        _showVehicleDialog = false;

        _showOperatorDialog = false;

        _showDeleteDialog = false;

        _recordToDelete = null;
    }


    private void OpenVehicleDialog()
    {
        _showVehicleDialog = true;
    }


    private void CloseVehicleDialog()
    {
        _showVehicleDialog = false;
    }


    private Task OnVehicleSelected(
        Guid vehicleId)
    {
        _dialogVehicleId = vehicleId;

        _showVehicleDialog = false;

        return Task.CompletedTask;
    }


    private void OpenOperatorDialog()
    {
        _showOperatorDialog = true;
    }


    private void CloseOperatorDialog()
    {
        _showOperatorDialog = false;
    }


    private Task OnOperatorSelected(
        Guid operatorId)
    {
        _dialogOperatorId = operatorId;

        _showOperatorDialog = false;

        return Task.CompletedTask;
    }


    private string GetSelectedVehicleName()
    {
        if (!_dialogVehicleId.HasValue)
            return string.Empty;

        return _vehicles
            .FirstOrDefault(
                x => x.Id == _dialogVehicleId.Value)
            ?.Name
            ?? string.Empty;
    }


    private string GetSelectedOperatorName()
    {
        if (!_dialogOperatorId.HasValue)
            return string.Empty;

        return _operators
            .FirstOrDefault(
                x => x.Id == _dialogOperatorId.Value)
            ?.FullName
            ?? string.Empty;
    }


    private string GetFuelTruckName(
        FuelTruck fuelTruck)
    {
        return fuelTruck.Vehicle?.Name
            ?? "Неизвестный топливозаправщик";
    }


    private string FormatLocalDateTime(
        DateTimeOffset utcDateTime)
    {
        return TimeZoneService
            .ToLocal(utcDateTime)
            .ToString("HH:mm");
    }


    private string GetUssDisplayText(
        Guid fuelingRecordId)
    {
        var record = _fuelingRecords
            .FirstOrDefault(x => x.Id == fuelingRecordId);

        if (record is null || record.UssRecords.Count == 0)
            return "—";

        if (record.UssRecords.Count == 1)
        {
            var uss = record.UssRecords.First();

            return $"{uss.VolumeLiters:0.###} л";
        }

        var totalVolume = record.UssRecords
            .Sum(x => x.VolumeLiters);

        return $"{totalVolume:0.###} л";
    }

    private string GetUssSelectionText(Guid? fuelingRecordId)
    {
        var selectedIds = _selectedUssEventIds;

        if (selectedIds.Count == 0)
            return string.Empty;

        // Если события Omnicomm уже загружены —
        // отображаем текущее состояние выбора пользователя.
        if (_ussEvents.Count > 0)
        {
            var selectedEvents = _ussEvents
                .Where(x => selectedIds.Contains(x.Id))
                .ToList();

            if (selectedEvents.Count > 0)
            {
                if (selectedEvents.Count == 1)
                {
                    var item = selectedEvents[0];

                    return $"{item.VolumeLiters:0.###} л";
                }

                var totalVolume = selectedEvents
                    .Sum(x => x.VolumeLiters);

                return $"{totalVolume:0.###} л";
            }
        }

        // Если Omnicomm ещё не загружен, используем сохранённые
        // записи из FuelingRecord.
        var fuelingRecord = _fuelingRecords
            .FirstOrDefault(x => x.Id == fuelingRecordId);

        if (fuelingRecord?.UssRecords is { Count: > 0 })
        {
            var savedRecords = fuelingRecord.UssRecords
                .Where(x => selectedIds.Contains(x.OmnicommEventId))
                .ToList();

            if (savedRecords.Count == 1)
            {
                var item = savedRecords[0];

                return $"{item.VolumeLiters:0.###} л";
            }

            if (savedRecords.Count > 1)
            {
                var totalVolume = savedRecords
                    .Sum(x => x.VolumeLiters);

                return $"{totalVolume:0.###} л";
            }
        }

        return string.Empty;
    }

    private Task OnUssSelected(
        IReadOnlyList<int> eventIds)
    {
        _selectedUssEventIds = eventIds.ToHashSet();
        _showUssDialog = false;

        return Task.CompletedTask;
    }

    private void CloseUssDialog()
    {
        _showUssDialog = false;
    }

    private async Task OpenUssDialog()
    {
        if (_selectedFuelTruckId == Guid.Empty)
            return;

        if (!_dialogVehicleId.HasValue)
        {
            _errorMessage = "Сначала выберите технику.";
            return;
        }

        _errorMessage = null;
        _speedReport = null;
        _showUssDialog = true;
        _isLoadingSpeed = true;
        try
        {
            _browserTimeZone =
                await BrowserTimeZoneService.GetAsync();
            _ussEvents = (
                    await FuelingUssService.GetAvailableEventsAsync(
                        _selectedFuelTruckId,
                         _dialogDate,
                        _browserTimeZone,
                        CancellationToken.None))
                .ToList();


            if (_ussEvents.Count == 0)
            {
                _showUssDialog = true;
                return;
            }

            var vehicle = _vehicles.FirstOrDefault(
                x => x.Id == _dialogVehicleId.Value);

            if (vehicle is null)
            {
                _errorMessage = "Выбранная техника не найдена.";
                return;
            }

            if (!vehicle.OmnicommObjectId.HasValue)
            {
                _errorMessage =
                    "У выбранной техники не указан OmnicommObjectId.";

                return;
            }

            var from = _ussEvents.Min(x => x.StartDate);
            var to = _ussEvents.Max(x => x.EndDate);

            _isLoadingSpeed = true;

            var vehicleOmnicommObjectId = _fuelTrucks.First(x => x.Id == _selectedFuelTruckId).Vehicle.OmnicommObjectId;
            if (vehicleOmnicommObjectId != null)
                _speedReport = await OmnicommSpeedService.GetSpeedAsync(
                    vehicleOmnicommObjectId.Value,
                    from,
                    to,
                    _browserTimeZone,
                    CancellationToken.None);

            _showUssDialog = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoadingSpeed = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
            return;

        _errorMessage = null;

        try
        {
            var localDateTime =
                _dialogDate.ToDateTime(
                    _dialogTime);

            var timeZone =
                TimeZoneService.GetCurrentTimeZone();

            var offset =
                timeZone.GetUtcOffset(
                    localDateTime);

            var localDateTimeOffset =
                new DateTimeOffset(
                    localDateTime,
                    offset);

            var fuelingDateTime =
                localDateTimeOffset.ToUniversalTime();


            if (_editingRecord is null)
            {
                var fuelingRecordId = await FuelingRecordService.CreateAsync(
                    _selectedFuelTruckId,
                    _dialogVehicleId!.Value,
                    _dialogOperatorId!.Value,
                    fuelingDateTime,
                    _dialogVolume,
                    _dialogCounterStart,
                    _dialogCounterEnd,
                    CancellationToken.None);
                if (_selectedUssEventIds.Count > 0)
                {
                    await FuelingUssService.AttachAsync(
                        fuelingRecordId,
                        _selectedUssEventIds.ToList(),
                        _browserTimeZone,
                        CancellationToken.None);
                }
            }
            else
            {
                await FuelingRecordService.UpdateAsync(
                    _editingRecord.Id,
                    _selectedFuelTruckId,
                    _dialogVehicleId!.Value,
                    _dialogOperatorId!.Value,
                    fuelingDateTime,
                    _dialogVolume,
                    _dialogCounterStart,
                    _dialogCounterEnd,
                    CancellationToken.None);
                await UpdateUssRecordsAsync(_editingRecord.Id);
            }
            _showDialog = false;

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task UpdateUssRecordsAsync(
        Guid fuelingRecordId)
    {
        var existingRecords =
            await FuelingUssService.GetByFuelingRecordIdAsync(
                fuelingRecordId,
                CancellationToken.None);

        var existingByEventId =
            existingRecords.ToDictionary(
                x => x.OmnicommEventId);

        // Удаляем отвязанные события.
        foreach (var existingRecord in existingRecords)
        {
            if (!_selectedUssEventIds.Contains(
                    existingRecord.OmnicommEventId))
            {
                await FuelingUssService.DetachAsync(
                    existingRecord.Id,
                    CancellationToken.None);
            }
        }

        // Добавляем новые события.
        var idsToAttach =
            _selectedUssEventIds
                .Where(eventId =>
                    !existingByEventId.ContainsKey(eventId))
                .ToList();

        if (idsToAttach.Count > 0)
        {
            await FuelingUssService.AttachAsync(
                fuelingRecordId,
                idsToAttach,
                _browserTimeZone,
                CancellationToken.None);
        }
    }

    private void OpenDeleteDialog(FuelControl.Domain.Entities.FuelingRecord record)
    {
        _errorMessage = null;

        _recordToDelete = record;

        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;

        _recordToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_recordToDelete is null)
            return;

        _errorMessage = null;

        try
        {
            var recordId = _recordToDelete.Id;

            _showDeleteDialog = false;
            _recordToDelete = null;

            await FuelingRecordService.DeleteAsync(
                recordId,
                CancellationToken.None);

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteAsync(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        _errorMessage = null;

        try
        {
            await FuelingRecordService.DeleteAsync(
                record.Id,
                CancellationToken.None);

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}