@page "/refuels/add"
@rendermode InteractiveServer

@using FuelControl.Components.Pages.FuelingRecord.Dialogs
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Services.Interfaces

@inject IFuelingRecordService FuelingRecordService
@inject IFuelTruckService FuelTruckService
@inject IVehicleService VehicleService
@inject IOperatorService OperatorService
@inject ITimeZoneService TimeZoneService

<PageTitle>Заправки</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Заправки
        </h3>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!CanAddFuelingRecord)"
                @onclick="OpenCreateDialog">

            <i class="bi bi-plus-lg me-1"></i>

            Добавить заправку
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <!-- Фильтр -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Топливозаправщик
                    </label>

                    <select class="form-select"
                            value="@selectedFuelTruckId"
                            @onchange="OnFuelTruckChanged">

                        <option value="@Guid.Empty">
                            Выберите топливозаправщик
                        </option>

                        @foreach (var fuelTruck in fuelTrucks)
                        {
                            <option value="@fuelTruck.Id">
                                @GetFuelTruckName(fuelTruck)
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Дата
                    </label>

                    <input type="date"
                           class="form-control"
                           value="@selectedDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" />

                </div>

            </div>

        </div>

    </div>

    <!-- Список заправок -->

    <div class="card">

        <div class="card-body p-0">

            @if (isLoading)
            {
                <div class="p-4 text-center">

                    <div class="spinner-border"
                         role="status">

                        <span class="visually-hidden">
                            Загрузка...
                        </span>

                    </div>

                </div>
            }
            else if (selectedFuelTruckId == Guid.Empty)
            {
                <div class="p-4 text-center text-muted">
                    Выберите топливозаправщик.
                </div>
            }
            else if (fuelingRecords.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    За выбранную дату заправок нет.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Время
                                </th>

                                <th>
                                    Техника
                                </th>

                                <th>
                                    Водитель
                                </th>

                                <th>
                                    Начальные показания
                                </th>

                                <th>
                                    Конечные показания
                                </th>

                                <th>
                                    Объём, л
                                </th>

                                <th>
                                    Показания УСС
                                </th>

                                <th>
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var record in fuelingRecords)
                            {
                                <tr>

                                    <td>
                                        @FormatLocalDateTime(
                                            record.FuelingDateTime)
                                    </td>

                                    <td>
                                        @record.Vehicle?.Name
                                    </td>

                                    <td>
                                        @record.Operator?.FullName
                                    </td>

                                    <td>
                                        @record.CounterStart
                                    </td>

                                    <td>
                                        @record.CounterEnd
                                    </td>

                                    <td>
                                        @record.Volume
                                    </td>

                                    <td>
                                        @GetUssDisplayText(record.Id)
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenEditDialog(record)">
                                            <span class="bi bi-pencil"></span>
                                            Изменить
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => OpenDeleteDialog(record)">
                                            <span class="bi bi-trash"></span>
                                            Удалить
                                        </button>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- Диалог выбора техники -->

<VehicleSelectDialog
    Visible="@showVehicleDialog"
    Vehicles="@vehicles"
    SelectedVehicleId="@dialogVehicleId"
    OnSelected="@OnVehicleSelected"
    OnClosed="@CloseVehicleDialog" />


<!-- Диалог выбора водителя -->

<OperatorSelectDialog
    Visible="@showOperatorDialog"
    Operators="@operators"
    SelectedOperatorId="@dialogOperatorId"
    OnSelected="@OnOperatorSelected"
    OnClosed="@CloseOperatorDialog" />


<!-- Диалог добавления / редактирования -->

@if (showDialog)
{
    <div class="modal fade show d-block fueling-record-modal"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

    <div class="modal-dialog modal-lg modal-dialog-centered">

    <div class="modal-content">

    <div class="modal-header">

        <h5 class="modal-title">

            @(editingRecord is null
                ? "Добавление заправки"
                : "Редактирование заправки")

        </h5>

        <button type="button"
                class="btn-close"
                @onclick="CloseDialog">
        </button>

    </div>

    <div class="modal-body">

        <div class="row g-3">

            <!-- Дата -->

            <div class="col-md-6">

                <label class="form-label">
                    Дата
                </label>

                <input type="date"
                       class="form-control"
                       @bind="dialogDate" />

            </div>


            <!-- Время -->

            <div class="col-md-6">

                <label class="form-label">
                    Время
                </label>

                <input type="time"
                       class="form-control"
                       @bind="dialogTime" />

            </div>


            <!-- Техника -->

            <div class="col-md-12">

                <label class="form-label">
                    Техника
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                           value="@GetSelectedVehicleName()"
                           placeholder="Техника не выбрана" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenVehicleDialog">

                        Выбрать

                    </button>

                </div>

            </div>


            <!-- Водитель -->

            <div class="col-md-12">

                <label class="form-label">
                    Водитель
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                           value="@GetSelectedOperatorName()"
                           placeholder="Водитель не выбран" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="OpenOperatorDialog">

                        Выбрать

                    </button>

                </div>

            </div>


            <!-- Счётчик -->

            <div class="col-md-4">

                <label class="form-label">
                    Начальные показания
                </label>

                <input type="number"
                       class="form-control"
                       min="0"
                       @bind="dialogCounterStart" />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Конечные показания
                </label>

                <input type="number"
                       class="form-control"
                       min="0"
                       @bind="dialogCounterEnd" />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Объём, л
                </label>

                <input type="number"
                       class="form-control"
                       min="1"
                       @bind="dialogVolume" />

            </div>


            <!-- УСС -->

            <div class="col-md-12">

                <label class="form-label">
                    Показания УСС
                </label>

                <div class="input-group">

                    <input class="form-control"
                           readonly
                           value="@GetUssSelectionText()"
                           placeholder="Показания УСС не выбраны" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@(!CanSelectUss)"
                            @onclick="OpenUssDialog">

                        Выбрать показания УСС

                    </button>

                </div>

            </div>

        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                @onclick="CloseDialog">

            Отмена

        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!CanSave)"
                @onclick="SaveAsync">

            Сохранить

        </button>

    </div>

    </div>

    </div>

    </div>
}
@if (showDeleteDialog && recordToDelete is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Подтверждение удаления
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDeleteDialog">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-3">
                        Вы действительно хотите удалить эту заправку?
                    </p>

                    <div class="border rounded p-3">

                        <div>
                            <strong>Дата:</strong>
                            @FormatLocalDateTime(
                                recordToDelete.FuelingDateTime)
                        </div>

                        <div>
                            <strong>Техника:</strong>
                            @recordToDelete.Vehicle?.Name
                        </div>

                        <div>
                            <strong>Водитель:</strong>
                            @recordToDelete.Operator?.FullName
                        </div>

                        <div>
                            <strong>Объём:</strong>
                            @recordToDelete.Volume л
                        </div>

                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        После удаления восстановить запись будет невозможно.
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDeleteDialog">

                        Отмена

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDeleteAsync">

                        <i class="bi bi-trash me-1"></i>

                        Удалить

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {
    private bool showDeleteDialog;

    private FuelControl.Domain.Entities.FuelingRecord? recordToDelete;
    private readonly List<FuelTruck> fuelTrucks = [];
    private readonly List<Vehicle> vehicles = [];
    private readonly List<Operator> operators = [];

    private List<FuelControl.Domain.Entities.FuelingRecord> fuelingRecords = [];

    private Guid selectedFuelTruckId = Guid.Empty;

    private DateOnly selectedDate =
        DateOnly.FromDateTime(DateTime.Now);

    private bool isLoading;

    private string? errorMessage;

    private bool showDialog;
    private bool showVehicleDialog;
    private bool showOperatorDialog;

    private FuelControl.Domain.Entities.FuelingRecord? editingRecord;

    private DateOnly dialogDate;

    private TimeOnly dialogTime;

    private Guid? dialogVehicleId;

    private Guid? dialogOperatorId;

    private int dialogCounterStart;

    private int dialogCounterEnd;

    private int dialogVolume;

    private List<FuelingUssRecord> selectedUssRecords = [];


    private bool CanAddFuelingRecord =>
        selectedFuelTruckId != Guid.Empty;


    private bool CanSelectUss =>
        selectedFuelTruckId != Guid.Empty;


    private bool CanSave =>
        selectedFuelTruckId != Guid.Empty
        && dialogVehicleId.HasValue
        && dialogOperatorId.HasValue
        && dialogVolume > 0
        && dialogCounterStart >= 0
        && dialogCounterEnd >= dialogCounterStart;


    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
    }


    private async Task LoadReferenceDataAsync()
    {
        fuelTrucks.Clear();

        fuelTrucks.AddRange(
            await FuelTruckService.GetAllAsync());


        vehicles.Clear();

        vehicles.AddRange(
            await VehicleService.GetAllAsync());


        operators.Clear();

        operators.AddRange(
            await OperatorService.GetAllAsync());
    }


    private async Task OnFuelTruckChanged(
        ChangeEventArgs args)
    {
        errorMessage = null;

        if (Guid.TryParse(
                args.Value?.ToString(),
                out var id))
        {
            selectedFuelTruckId = id;
        }
        else
        {
            selectedFuelTruckId = Guid.Empty;
        }

        await LoadFuelingRecordsAsync();
    }


    private async Task OnDateChanged(
        ChangeEventArgs args)
    {
        errorMessage = null;

        if (DateOnly.TryParse(
                args.Value?.ToString(),
                out var date))
        {
            selectedDate = date;
        }

        await LoadFuelingRecordsAsync();
    }


    private async Task LoadFuelingRecordsAsync()
    {
        if (selectedFuelTruckId == Guid.Empty)
        {
            fuelingRecords = [];
            return;
        }

        isLoading = true;

        try
        {
            var timeZone =
                TimeZoneService.GetCurrentTimeZone();

            fuelingRecords = (
                await FuelingRecordService.GetAllAsync(
                    selectedDate,
                    timeZone,
                    selectedFuelTruckId,
                    CancellationToken.None))
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            fuelingRecords = [];
        }
        finally
        {
            isLoading = false;
        }
    }


    private void OpenCreateDialog()
    {
        if (selectedFuelTruckId == Guid.Empty)
        {
            errorMessage =
                "Сначала выберите топливозаправщик.";

            return;
        }

        errorMessage = null;

        editingRecord = null;

        dialogDate = selectedDate;

        dialogTime =
            TimeOnly.FromDateTime(DateTime.Now);

        dialogVehicleId = null;

        dialogOperatorId = null;

        dialogCounterStart = 0;

        dialogCounterEnd = 0;

        dialogVolume = 0;

        selectedUssRecords = [];

        showDialog = true;
    }


    private void OpenEditDialog(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        editingRecord = record;

        var localDateTime =
            TimeZoneService.ToLocal(
                record.FuelingDateTime);

        dialogDate =
            DateOnly.FromDateTime(
                localDateTime.DateTime);

        dialogTime =
            TimeOnly.FromDateTime(
                localDateTime.DateTime);

        dialogVehicleId =
            record.VehicleId;

        dialogOperatorId =
            record.OperatorId;

        dialogCounterStart =
            record.CounterStart;

        dialogCounterEnd =
            record.CounterEnd;

        dialogVolume =
            record.Volume;

        selectedUssRecords = [];

        showDialog = true;
    }


    private void CloseDialog()
    {
        showDialog = false;

        editingRecord = null;

        showVehicleDialog = false;

        showOperatorDialog = false;

        showDeleteDialog = false;

        recordToDelete = null;
    }


    private void OpenVehicleDialog()
    {
        showVehicleDialog = true;
    }


    private void CloseVehicleDialog()
    {
        showVehicleDialog = false;
    }


    private Task OnVehicleSelected(
        Guid vehicleId)
    {
        dialogVehicleId = vehicleId;

        showVehicleDialog = false;

        return Task.CompletedTask;
    }


    private void OpenOperatorDialog()
    {
        showOperatorDialog = true;
    }


    private void CloseOperatorDialog()
    {
        showOperatorDialog = false;
    }


    private Task OnOperatorSelected(
        Guid operatorId)
    {
        dialogOperatorId = operatorId;

        showOperatorDialog = false;

        return Task.CompletedTask;
    }


    private string GetSelectedVehicleName()
    {
        if (!dialogVehicleId.HasValue)
            return string.Empty;

        return vehicles
            .FirstOrDefault(
                x => x.Id == dialogVehicleId.Value)
            ?.Name
            ?? string.Empty;
    }


    private string GetSelectedOperatorName()
    {
        if (!dialogOperatorId.HasValue)
            return string.Empty;

        return operators
            .FirstOrDefault(
                x => x.Id == dialogOperatorId.Value)
            ?.FullName
            ?? string.Empty;
    }


    private string GetFuelTruckName(
        FuelTruck fuelTruck)
    {
        return fuelTruck.Vehicle?.Name
            ?? "Неизвестный топливозаправщик";
    }


    private string FormatLocalDateTime(
        DateTimeOffset utcDateTime)
    {
        return TimeZoneService
            .ToLocal(utcDateTime)
            .ToString("HH:mm");
    }


    private string GetUssDisplayText(
        Guid fuelingRecordId)
    {
        return "—";
    }


    private string GetUssSelectionText()
    {
        if (selectedUssRecords.Count == 0)
            return string.Empty;

        if (selectedUssRecords.Count == 1)
        {
            var record =
                selectedUssRecords[0];

            return
                $"{record.StartDate:HH:mm:ss} - " +
                $"{record.EndDate:HH:mm:ss}, " +
                $"{record.VolumeLiters:N1} л";
        }

        return
            $"Выбрано записей: " +
            $"{selectedUssRecords.Count}";
    }


    private void OpenUssDialog()
    {
        // Реализуем после подключения
        // UssSelectDialog.
    }


    private async Task SaveAsync()
    {
        if (!CanSave)
            return;

        errorMessage = null;

        try
        {
            var localDateTime =
                dialogDate.ToDateTime(
                    dialogTime);

            var timeZone =
                TimeZoneService.GetCurrentTimeZone();

            var offset =
                timeZone.GetUtcOffset(
                    localDateTime);

            var localDateTimeOffset =
                new DateTimeOffset(
                    localDateTime,
                    offset);

            var fuelingDateTime =
                localDateTimeOffset.ToUniversalTime();


            if (editingRecord is null)
            {
                await FuelingRecordService.CreateAsync(
                    selectedFuelTruckId,
                    dialogVehicleId!.Value,
                    dialogOperatorId!.Value,
                    fuelingDateTime,
                    dialogVolume,
                    dialogCounterStart,
                    dialogCounterEnd,
                    CancellationToken.None);
            }
            else
            {
                await FuelingRecordService.UpdateAsync(
                    editingRecord.Id,
                    selectedFuelTruckId,
                    dialogVehicleId!.Value,
                    dialogOperatorId!.Value,
                    fuelingDateTime,
                    dialogVolume,
                    dialogCounterStart,
                    dialogCounterEnd,
                    CancellationToken.None);
            }

            showDialog = false;

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OpenDeleteDialog(FuelControl.Domain.Entities.FuelingRecord record)
    {
        errorMessage = null;

        recordToDelete = record;

        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;

        recordToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (recordToDelete is null)
            return;

        errorMessage = null;

        try
        {
            var recordId = recordToDelete.Id;

            showDeleteDialog = false;
            recordToDelete = null;

            await FuelingRecordService.DeleteAsync(
                recordId,
                CancellationToken.None);

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteAsync(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        errorMessage = null;

        try
        {
            await FuelingRecordService.DeleteAsync(
                record.Id,
                CancellationToken.None);

            await LoadFuelingRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}