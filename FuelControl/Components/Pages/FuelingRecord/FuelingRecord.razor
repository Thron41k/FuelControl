@page "/refuels/add"
@rendermode InteractiveServer
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Services.Interfaces
@using FuelControl.Omnicomm.Reports.Models

@inject IFuelingRecordService FuelingRecordService
@inject IFuelingUssService FuelingUssService
@inject IFuelTruckService FuelTruckService
@inject IVehicleService VehicleService
@inject IOperatorService OperatorService

<PageTitle>Заправки</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            Заправки
        </h3>

        <button class="btn btn-primary"
                disabled="@(!CanAdd)"
                @onclick="OpenCreateDialog">
            <i class="bi bi-plus-lg me-1"></i>
            Добавить заправку
        </button>
    </div>

    <div class="card mb-3">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label class="form-label">
                        Топливозаправщик
                    </label>

                    <select class="form-select"
                            value="@selectedFuelTruckId"
                            @onchange="OnFuelTruckChanged">

                        <option value="">
                            Выберите топливозаправщик
                        </option>

                        @foreach (var fuelTruck in fuelTrucks)
                        {
                            <option value="@fuelTruck.Id">
                                @GetFuelTruckName(fuelTruck)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Дата
                    </label>

                    <input type="date"
                           class="form-control"
                           value="@selectedDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" />
                </div>

            </div>

        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    Загрузка...
                </span>
            </div>
        </div>
    }
    else if (!CanAdd)
    {
        <div class="alert alert-info">
            Выберите топливозаправщик и дату.
        </div>
    }
    else
    {
        <div class="card">

            <div class="card-header d-flex justify-content-between">
                <strong>
                    Заправки
                </strong>

                <span class="text-muted">
                    @selectedDate.ToString("dd.MM.yyyy")
                </span>
            </div>

            <div class="card-body p-0">

                @if (fuelingRecords.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        За выбранную дату заправок нет.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover table-striped mb-0">

                            <thead>
                                <tr>
                                    <th>Дата / время</th>
                                    <th>Техника</th>
                                    <th>Водитель</th>
                                    <th>Начальные</th>
                                    <th>Конечные</th>
                                    <th>Объём, л</th>
                                    <th>Показания УСС</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var recordItem in fuelingRecords)
                                {
                                    <tr>

                                        <td>
                                            recordItem.FuelingDateTime.ToLocalTime()
                                            .ToString("dd.MM.yyyy HH:mm")
                                        </td>

                                        <td>
                                            recordItem.Vehicle.Name
                                        </td>

                                        <td>
                                            recordItem.Operator.FullName
                                        </td>

                                        <td>
                                            recordItem.CounterStart
                                        </td>

                                        <td>
                                            recordItem.CounterEnd
                                        </td>

                                        <td>
                                            recordItem.Volume
                                        </td>

                                        <td>
                                            @if (recordItem.UssRecords.Count == 0)
                                            {
                                                <span class="text-muted">
                                                    Нет
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                recordItem.UssRecords
                                                    .Sum(x => x.VolumeLiters)
                                                    .ToString("N1") л
                                                </span>

                                                <span class="text-muted ms-1">
                                                (recordItem.UssRecords.Count)
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary me-1"
                                                    @onclick="() => OpenEditDialog(recordItem)">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DeleteAsync(recordItem)">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }

</div>

@if (showDialog)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(editingRecord is null
                            ? "Добавление заправки"
                            : "Редактирование заправки")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDialog">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label class="form-label">
                                Топливозаправщик
                            </label>

                            <input class="form-control"
                                   value="@GetSelectedFuelTruckName()"
                                   disabled />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Дата
                            </label>

                            <input type="date"
                                   class="form-control"
                                   @bind="dialogDate" />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Время
                            </label>

                            <input type="time"
                                   class="form-control"
                                   @bind="dialogTime" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Техника
                            </label>

                            <select class="form-select"
                                    @bind="dialogVehicleId">

                                <option value="">
                                    Выберите технику
                                </option>

                                @foreach (var vehicle in vehicles)
                                {
                                    <option value="@vehicle.Id">
                                        @vehicle.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Водитель
                            </label>

                            <select class="form-select"
                                    @bind="dialogOperatorId">

                                <option value="">
                                    Выберите водителя
                                </option>

                                @foreach (var driver in operators)
                                {
                                    <option value="@driver.Id">
                                        @driver.FullName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Начальные показания
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   @bind="dialogCounterStart" />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Конечные показания
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   @bind="dialogCounterEnd" />

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Объём, л
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="1"
                                   @bind="dialogVolume" />

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <strong>
                                Показания УСС
                            </strong>

                            @if (selectedUssEvents.Count > 0)
                            {
                                <span class="text-muted ms-2">
                                    выбрано: @selectedUssEvents.Count
                                </span>
                            }
                        </div>

                        <button class="btn btn-outline-primary"
                                @onclick="OpenUssDialog"
                                disabled="@(!CanSelectUss)">
                            <i class="bi bi-list-check me-1"></i>
                            Выбрать показания УСС
                        </button>

                    </div>

                    @if (selectedUssEvents.Count > 0)
                    {
                        <div class="mt-3">

                            <table class="table table-sm table-bordered">

                                <thead>
                                    <tr>
                                        <th>Событие</th>
                                        <th>Начало</th>
                                        <th>Окончание</th>
                                        <th>Объём, л</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in selectedUssEvents)
                                    {
                                        <tr>
                                            <td>
                                                @item.Name
                                            </td>

                                            <td>
                                                @item.StartDate
                                                .ToLocalTime()
                                                .ToString("HH:mm:ss")
                                            </td>

                                            <td>
                                                @item.EndDate
                                                .ToLocalTime()
                                                .ToString("HH:mm:ss")
                                            </td>

                                            <td>
                                                @item.VolumeLiters.ToString("N1")
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDialog">
                        Отмена
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(!CanSave)"
                            @onclick="SaveAsync">
                        Сохранить
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@if (showUssDialog)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Выбор показаний УСС
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseUssDialog">
                    </button>

                </div>

                <div class="modal-body">

                    @if (ussLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border"></div>
                        </div>
                    }
                    else if (ussEvents.Count == 0)
                    {
                        <div class="alert alert-info">
                            За выбранную дату показаний УСС не найдено.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>Название</th>
                                        <th>Начало</th>
                                        <th>Окончание</th>
                                        <th>Объём, л</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var ussEvent in ussEvents)
                                    {
                                        <tr @ondblclick="() => ToggleUssEvent(ussEvent)">

                                            <td>
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       checked="@IsUssSelected(ussEvent)"
                                                       @onchange="() => ToggleUssEvent(ussEvent)" />
                                            </td>

                                            <td>
                                                @ussEvent.Name
                                            </td>

                                            <td>
                                                @ussEvent.StartDate
                                                .ToLocalTime()
                                                .ToString("HH:mm:ss")
                                            </td>

                                            <td>
                                                @ussEvent.EndDate
                                                .ToLocalTime()
                                                .ToString("HH:mm:ss")
                                            </td>

                                            <td>
                                                @ussEvent.VolumeLiters
                                                .ToString("N1")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <span class="me-auto">
                        Выбрано: <strong>@selectedUssEvents.Count</strong>
                    </span>

                    <button class="btn btn-secondary"
                            @onclick="CloseUssDialog">
                        Отмена
                    </button>

                    <button class="btn btn-primary"
                            @onclick="ConfirmUssSelection">
                        Выбрать
                    </button>

                </div>

            </div>

        </div>

    </div>
}
@code {

    private List<FuelTruck> fuelTrucks = [];
    private List<Vehicle> vehicles = [];
    private List<Operator> operators = [];

    private List<FuelControl.Domain.Entities.FuelingRecord> fuelingRecords = [];

    private List<OmnicommDeliveryEvent> ussEvents = [];
    private List<OmnicommDeliveryEvent> selectedUssEvents = [];

    private Guid? selectedFuelTruckId;

    private DateOnly selectedDate =
        DateOnly.FromDateTime(DateTime.Today);

    private bool isLoading;

    private bool showDialog;
    private bool showUssDialog;
    private bool ussLoading;

    private FuelControl.Domain.Entities.FuelingRecord? editingRecord;

    private DateOnly dialogDate;
    private TimeOnly dialogTime;

    private Guid? dialogVehicleId;
    private Guid? dialogOperatorId;

    private int dialogCounterStart;
    private int dialogCounterEnd;
    private int dialogVolume;

    private bool CanAdd =>
        selectedFuelTruckId.HasValue;

    private bool CanSelectUss =>
        selectedFuelTruckId.HasValue;

    private bool CanSave =>
        selectedFuelTruckId.HasValue &&
        dialogVehicleId.HasValue &&
        dialogOperatorId.HasValue &&
        dialogVolume > 0 &&
        dialogCounterStart >= 0 &&
        dialogCounterEnd >= dialogCounterStart;

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        isLoading = true;

        try
        {
            fuelTrucks = (await FuelTruckService.GetAllAsync())
                .ToList();

            vehicles = (await VehicleService.GetAllAsync())
                .ToList();

            operators = (await OperatorService.GetAllAsync())
                .Where(x => x.IsActive)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFuelTruckChanged(
        ChangeEventArgs args)
    {
        if (Guid.TryParse(
                args.Value?.ToString(),
                out var id))
        {
            selectedFuelTruckId = id;
        }
        else
        {
            selectedFuelTruckId = null;
        }

        await LoadFuelingRecordsAsync();
    }

    private async Task OnDateChanged(
        ChangeEventArgs args)
    {
        if (DateOnly.TryParse(
                args.Value?.ToString(),
                out var date))
        {
            selectedDate = date;
        }

        await LoadFuelingRecordsAsync();
    }

    private async Task LoadFuelingRecordsAsync()
    {
        if (!selectedFuelTruckId.HasValue)
        {
            fuelingRecords = [];
            return;
        }

        isLoading = true;

        try
        {
            fuelingRecords = (
                await FuelingRecordService.GetAllAsync(
                    selectedDate,
                    selectedFuelTruckId.Value))
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        editingRecord = null;

        dialogDate = selectedDate;

        dialogTime = TimeOnly.FromDateTime(
            DateTime.Now);

        dialogVehicleId = null;
        dialogOperatorId = null;

        dialogCounterStart = 0;
        dialogCounterEnd = 0;
        dialogVolume = 0;

        selectedUssEvents = [];

        showDialog = true;
    }

    private void OpenEditDialog(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        editingRecord = record;

        dialogDate = DateOnly.FromDateTime(
            record.FuelingDateTime.DateTime);

        dialogTime = TimeOnly.FromDateTime(
            record.FuelingDateTime.DateTime);

        dialogVehicleId = record.VehicleId;
        dialogOperatorId = record.OperatorId;

        dialogCounterStart = record.CounterStart;
        dialogCounterEnd = record.CounterEnd;
        dialogVolume = record.Volume;

        selectedUssEvents = record.UssRecords
            .Select(x => new OmnicommDeliveryEvent
            {
                Id = x.OmnicommEventId,
                VehicleId = x.OmnicommFuelTruckId,
                Name = x.Name,
                StartDate = x.StartDate,
                EndDate = x.EndDate,
                VolumeLiters = x.VolumeLiters
            })
            .ToList();

        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
    }

    private async Task SaveAsync()
    {
        if (!CanSave ||
            !selectedFuelTruckId.HasValue ||
            !dialogVehicleId.HasValue ||
            !dialogOperatorId.HasValue)
        {
            return;
        }

        var dateTime = dialogDate.ToDateTime(
            dialogTime,
            DateTimeKind.Unspecified);

        var fuelingDateTime = new DateTimeOffset(
            dateTime,
            TimeZoneInfo.Local.GetUtcOffset(dateTime));

        if (editingRecord is null)
        {
            await FuelingRecordService.CreateAsync(
                selectedFuelTruckId.Value,
                dialogVehicleId.Value,
                dialogOperatorId.Value,
                fuelingDateTime,
                dialogVolume,
                dialogCounterStart,
                dialogCounterEnd);
        }
        else
        {
            await FuelingRecordService.UpdateAsync(
                editingRecord.Id,
                selectedFuelTruckId.Value,
                dialogVehicleId.Value,
                dialogOperatorId.Value,
                fuelingDateTime,
                dialogVolume,
                dialogCounterStart,
                dialogCounterEnd);
        }

        showDialog = false;

        await LoadFuelingRecordsAsync();
    }

    private async Task DeleteAsync(
        FuelControl.Domain.Entities.FuelingRecord record)
    {
        await FuelingRecordService.DeleteAsync(
            record.Id);

        await LoadFuelingRecordsAsync();
    }

    private async Task OpenUssDialog()
    {
        if (!selectedFuelTruckId.HasValue)
        {
            return;
        }

        ussLoading = true;
        showUssDialog = true;

        try
        {
            ussEvents = (
                await FuelingUssService.GetAvailableEventsAsync(
                    selectedFuelTruckId.Value,
                    dialogDate))
                .ToList();
        }
        finally
        {
            ussLoading = false;
        }
    }

    private void CloseUssDialog()
    {
        showUssDialog = false;
    }

    private void ToggleUssEvent(
        OmnicommDeliveryEvent ussEvent)
    {
        var existing = selectedUssEvents
            .FirstOrDefault(x => x.Id == ussEvent.Id);

        if (existing is not null)
        {
            selectedUssEvents.Remove(existing);
        }
        else
        {
            selectedUssEvents.Add(ussEvent);
        }
    }

    private bool IsUssSelected(
        OmnicommDeliveryEvent ussEvent)
    {
        return selectedUssEvents.Any(
            x => x.Id == ussEvent.Id);
    }

    private void ConfirmUssSelection()
    {
        showUssDialog = false;
    }

    private string GetFuelTruckName(
        FuelTruck fuelTruck)
    {
        return fuelTruck.Vehicle?.Name
            ?? fuelTruck.Id.ToString();
    }

    private string GetSelectedFuelTruckName()
    {
        if (!selectedFuelTruckId.HasValue)
        {
            return string.Empty;
        }

        var fuelTruck = fuelTrucks.FirstOrDefault(
            x => x.Id == selectedFuelTruckId.Value);

        return fuelTruck is null
            ? string.Empty
            : GetFuelTruckName(fuelTruck);
    }
}