@using FuelControl.Domain.Entities
@using FuelControl.Omnicomm.Reports.Models

@if (Visible)
{
    <div class="modal fade show d-block uss-select-modal"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5); z-index: 1060;">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Выбор показаний УСС
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@Loading"
                            @onclick="Close">
                    </button>

                </div>

                <div class="modal-body">

                    @if (Loading)
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center py-5"
                             style="min-height: 300px;">

                            <div class="spinner-border text-primary mb-3"
                                 role="status"
                                 style="width: 3rem; height: 3rem;">

                                <span class="visually-hidden">
                                    Загрузка...
                                </span>

                            </div>

                            <div class="fw-semibold">
                                Загрузка данных из Omnicomm…
                            </div>

                            <div class="text-muted small mt-1">
                                Получение показаний УСС и данных о скорости
                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- Фильтр по скорости -->

                        <div class="card mb-3">

                            <div class="card-body">

                                <div class="row g-3 align-items-end">

                                    <div class="col-md-5">

                                        <div class="form-check form-switch">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="speedFilterEnabled"
                                                   @bind="_speedFilterEnabled" />

                                            <label class="form-check-label"
                                                   for="speedFilterEnabled">

                                                Фильтр по скорости

                                            </label>

                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <label class="form-label">
                                            Максимальная скорость, км/ч
                                        </label>

                                        <input type="number"
                                               class="form-control"
                                               min="0"
                                               step="0.1"
                                               @bind="_maxAllowedSpeed"
                                               disabled="@(!_speedFilterEnabled)" />

                                    </div>

                                    @if (_speedFilterEnabled)
                                    {
                                        <div class="col-md-3">

                                            <div class="text-muted small">

                                                Показания отбираются,
                                                если скорость на всём интервале
                                                не превышает заданный предел.

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        @if (SpeedReport is null)
                        {
                            <div class="alert alert-warning">

                                <i class="bi bi-exclamation-triangle me-2"></i>

                                Данные о скорости недоступны.

                            </div>
                        }


                        @if (!FilteredEvents.Any())
                        {
                            <div class="text-center text-muted py-5">

                                Показаний УСС за выбранную дату не найдено.

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead>

                                        <tr>

                                            <th style="width: 50px;">
                                            </th>

                                            <th>
                                                Начало
                                            </th>

                                            <th>
                                                Конец
                                            </th>

                                            <th>
                                                Название
                                            </th>

                                            <th>
                                                Объём, л
                                            </th>

                                            <th>
                                                Макс. скорость
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in FilteredEvents)
                                        {
                                            var isSelected =
                                                IsSelected(item.Id);

                                            var isAttachedToAnotherFueling =
                                                IsAttachedToAnotherFueling(item.Id);

                                            <tr class="
                                                @(isSelected ? "table-primary" : "")
                                                @(isAttachedToAnotherFueling
                                                    ? "table-secondary text-muted"
                                                    : "")"
                                                style="cursor: @(isAttachedToAnotherFueling
                                                                                                    ? "not-allowed"
                                                                                                    : "pointer");"
                                                @ondblclick="@(() =>
                                                                                                    SelectByDoubleClick(
                                                                                                        item,
                                                                                                        isAttachedToAnotherFueling))">

                                                <td>

                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           checked="@isSelected"
                                                           disabled="@isAttachedToAnotherFueling"
                                                           @onclick:stopPropagation="true"
                                                           @onchange="@(() =>
                                                                                                                          ToggleSelection(
                                                                                                                              item,
                                                                                                                              isAttachedToAnotherFueling))" />

                                                </td>

                                                <td>
                                                    @FormatUserTime(item.StartDate)
                                                </td>

                                                <td>
                                                    @FormatUserTime(item.EndDate)
                                                </td>

                                                <td>
                                                    @item.Name
                                                </td>

                                                <td>
                                                    @item.VolumeLiters.ToString("0.###")
                                                </td>

                                                <td>
                                                    @GetMaxSpeedText(item)
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                    }

                </div>


                <div class="modal-footer">

                    @if (Loading)
                    {
                        <div class="me-auto text-muted small">

                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status">
                            </span>

                            Выполняется загрузка данных…

                        </div>
                    }
                    else
                    {
                        <div class="me-auto text-muted">

                            Выбрано:
                            <strong>@_selectedIds.Count</strong>

                            @if (_selectedIds.Count > 0)
                            {
                                <span class="ms-3">

                                    Объём:

                                    <strong>
                                        @SelectedVolume.ToString("0.###") л
                                    </strong>

                                </span>
                            }

                        </div>
                    }


                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@Loading"
                            @onclick="Close">

                        Отмена

                    </button>


                    <button type="button"
                            class="btn btn-primary"
                            disabled="@Loading"
                            @onclick="Confirm">

                        <i class="bi bi-check-lg me-1"></i>

                        Выбрать

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code
{
    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool Visible { get; set; }


    [Parameter]
    public IReadOnlyList<OmnicommDeliveryEvent> Events { get; set; }
        = [];


    [Parameter]
    public IReadOnlyList<FuelingUssRecord> SavedUssRecords { get; set; }
        = [];


    [Parameter]
    public OmnicommSpeedReport? SpeedReport { get; set; }


    [Parameter]
    public IReadOnlySet<int> SelectedEventIds { get; set; }
        = new HashSet<int>();


    /// <summary>
    /// Идентификаторы событий УСС,
    /// которые уже привязаны к другим заправкам.
    /// </summary>
    [Parameter]
    public IReadOnlySet<int> AttachedEventIds { get; set; }
        = new HashSet<int>();


    [Parameter]
    public TimeZoneInfo UserTimeZone { get; set; }
        = TimeZoneInfo.Utc;


    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnSelected { get; set; }


    [Parameter]
    public EventCallback OnClosed { get; set; }


    private HashSet<int> _selectedIds = [];

    private bool _selectionInitialized;

    private bool _speedFilterEnabled = true;

    private decimal _maxAllowedSpeed = 20m;


    private bool IsAttachedToAnotherFueling(
        int eventId)
    {
        return AttachedEventIds.Contains(eventId);
    }


    private string FormatUserTime(
        DateTimeOffset dateTime)
    {
        return TimeZoneInfo.ConvertTime(
                dateTime,
                UserTimeZone)
            .ToString("HH:mm:ss");
    }


    private decimal SelectedVolume
    {
        get
        {
            var eventsById = Events
                .ToDictionary(x => x.Id);

            var savedById = SavedUssRecords
                .ToDictionary(x => x.OmnicommEventId);

            decimal total = 0;

            foreach (var eventId in _selectedIds)
            {
                if (eventsById.TryGetValue(
                        eventId,
                        out var omnicommEvent))
                {
                    total += omnicommEvent.VolumeLiters;
                    continue;
                }

                if (savedById.TryGetValue(
                        eventId,
                        out var savedRecord))
                {
                    total += savedRecord.VolumeLiters;
                }
            }

            return total;
        }
    }


    private bool IsSelected(
        int eventId)
    {
        return _selectedIds.Contains(eventId);
    }


    private IEnumerable<OmnicommDeliveryEvent> FilteredEvents
    {
        get
        {
            IEnumerable<OmnicommDeliveryEvent> result =
                Events;

            if (_speedFilterEnabled)
            {
                result = result.Where(HasAllowedSpeed);
            }

            return result;
        }
    }


    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            _selectionInitialized = false;
            return;
        }

        if (_selectionInitialized)
            return;

        _selectedIds =
            SelectedEventIds.ToHashSet();

        _selectionInitialized = true;
    }


    private bool HasAllowedSpeed(
        OmnicommDeliveryEvent item)
    {
        var maxSpeed =
            GetMaxSpeed(item);

        if (!maxSpeed.HasValue)
            return false;

        return maxSpeed.Value <=
               _maxAllowedSpeed;
    }


    private decimal? GetMaxSpeed(
        OmnicommDeliveryEvent item)
    {
        return SpeedReport?.GetMaxSpeed(
            item.StartDate,
            item.EndDate);
    }


    private string GetMaxSpeedText(
        OmnicommDeliveryEvent item)
    {
        var maxSpeed =
            GetMaxSpeed(item);

        return maxSpeed.HasValue
            ? $"{maxSpeed.Value:N1} км/ч"
            : "—";
    }


    private void ToggleSelection(
        OmnicommDeliveryEvent item,
        bool isAttachedToAnotherFueling)
    {
        if (isAttachedToAnotherFueling)
            return;

        if (!_selectedIds.Add(item.Id))
        {
            _selectedIds.Remove(item.Id);
        }
    }


    private async Task SelectByDoubleClick(
        OmnicommDeliveryEvent item,
        bool isAttachedToAnotherFueling)
    {
        if (isAttachedToAnotherFueling)
            return;

        ToggleSelection(
            item,
            isAttachedToAnotherFueling);

        await Confirm();
    }


    private async Task Confirm()
    {
        await OnSelected.InvokeAsync(
            _selectedIds.ToList());
    }


    private async Task Close()
    {
        await OnClosed.InvokeAsync();
    }
}