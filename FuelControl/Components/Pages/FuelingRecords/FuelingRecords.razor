@page "/fueling-records"
@rendermode InteractiveServer

@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Services
@using FuelControl.Infrastructure.Services.Interfaces
@using System.Security.Claims
@using FuelControl.Infrastructure.Services.Models
@using FuelControl.Components.Pages.FuelingRecord.Dialogs

@inject IFuelingRecordService FuelingRecordService
@inject IVehicleService VehicleService
@inject IUserTimeZoneService UserTimeZoneService
@inject IOmnicommFuelingSyncService OmnicommFuelingSyncService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Заправки</PageTitle>

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">
            Заправки
        </h3>

    </div>


    <!-- Фильтры -->

    <div class="card mb-3">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- Дата начала -->

                <div class="col-md-2">

                    <label class="form-label">
                        С
                    </label>

                    <input type="date"
                           class="form-control"
                           @bind="_fromDate" />

                </div>


                <!-- Дата окончания -->

                <div class="col-md-2">

                    <label class="form-label">
                        По
                    </label>

                    <input type="date"
                           class="form-control"
                           @bind="_toDate" />

                </div>


                <!-- Техника -->

                <div class="col-md">

                    <label class="form-label">
                        Техника
                    </label>

                    <div class="input-group">

                        <input class="form-control"
                               readonly
                               value="@GetSelectedVehicleName()"
                               placeholder="Выберите технику" />

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="OpenVehicleDialog">

                            <i class="bi bi-search me-1"></i>
                            Выбрать

                        </button>

                    </div>

                </div>


                <!-- Действия -->

                <div class="col-md-auto">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-primary"
                                disabled="@(_loading || !_selectedVehicleId.HasValue)"
                                @onclick="LoadRecords">

                            @if (_loading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }

                            Показать

                        </button>

                        <button type="button"
                                class="btn btn-outline-primary"
                                disabled="@(_loading
                                                                                                                                                                                                      || !_loaded
                                                                                                                                                                                                      || _syncing
                                                                                                                                                                                                      || !_selectedVehicleId.HasValue)"
                                @onclick="SyncOmnicomm">

                            @if (_syncing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-1"></i>
                            }

                            Обновить данные Omnicomm

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    @if (_loaded)
    {
        <div class="row g-3 mb-3">

            <!-- Ведомость -->

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex justify-content-between gap-4">

                            <div>
                                <div class="text-muted small mb-1">
                                    Объём по ведомости
                                </div>

                                <div class="fs-4 fw-semibold">
                                    @FormatVolume(GetStatementVolume())
                                </div>
                            </div>

                            <div class="text-end small">

                                <div class="text-muted mb-1">
                                    Расхождение
                                </div>

                                <div>
                                    с УСС:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetStatementVsUssDifferencePercent())">
                                        @FormatDifference(
                                            GetStatementVsUssDifferencePercent())
                                    </strong>
                                </div>

                                <div>
                                    с Omnicomm:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetStatementVsOmnicommDifferencePercent())">
                                        @FormatDifference(
                                            GetStatementVsOmnicommDifferencePercent())
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>


            <!-- УСС -->

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex justify-content-between gap-4">

                            <div>
                                <div class="text-muted small mb-1">
                                    Объём по УСС
                                </div>

                                <div class="fs-4 fw-semibold">
                                    @FormatVolume(GetUssVolume())
                                </div>
                            </div>

                            <div class="text-end small">

                                <div class="text-muted mb-1">
                                    Расхождение
                                </div>

                                <div>
                                    с ведомостью:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetUssVsStatementDifferencePercent())">
                                        @FormatDifference(
                                            GetUssVsStatementDifferencePercent())
                                    </strong>
                                </div>

                                <div>
                                    с Omnicomm:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetUssVsOmnicommDifferencePercent())">
                                        @FormatDifference(
                                            GetUssVsOmnicommDifferencePercent())
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>


            <!-- Omnicomm -->

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex justify-content-between gap-4">

                            <div>
                                <div class="text-muted small mb-1">
                                    Объём по Omnicomm
                                </div>

                                <div class="fs-4 fw-semibold">
                                    @FormatVolume(GetOmnicommVolume())
                                </div>
                            </div>

                            <div class="text-end small">

                                <div class="text-muted mb-1">
                                    Расхождение
                                </div>

                                <div>
                                    с ведомостью:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetOmnicommVsStatementDifferencePercent())">
                                        @FormatDifference(
                                            GetOmnicommVsStatementDifferencePercent())
                                    </strong>
                                </div>

                                <div>
                                    с УСС:
                                    <strong class="@GetDifferenceClass(
                                                                                                                                                                                                                    GetOmnicommVsUssDifferencePercent())">
                                        @FormatDifference(
                                            GetOmnicommVsUssDifferencePercent())
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>
    }

    <!-- Ошибка -->
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <!-- Загрузка -->
    @if (_loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 style="width: 3rem; height: 3rem;">
            </div>

            <div class="mt-3 text-muted">
                Загрузка заправок...
            </div>

        </div>
    }
    else if (_loaded)
    {
        @if (_records.Count == 0)
        {
            <div class="alert alert-info">
                Заправок за выбранный период не найдено.
            </div>
        }
        else
        {
            <div class="card">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Дата
                                    </th>

                                    <th>
                                        Техника
                                    </th>

                                    <th>
                                        Водитель
                                    </th>

                                    <th>
                                        Топливозаправщик
                                    </th>

                                    <th>
                                        Объём, л
                                    </th>

                                    <th>
                                        Счётчик
                                    </th>

                                    <th>
                                        УСС, л
                                    </th>
                                    <th>
                                        Omnicomm, л
                                    </th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var record in _records)
                                {
                                    <tr>

                                        <td>
                                            @FormatUserDateTime(
                                                record.FuelingDateTime)
                                        </td>

                                        <td>
                                            @record.Vehicle.Name
                                        </td>

                                        <td>
                                            @record.Operator.FullName
                                        </td>

                                        <td>
                                            @record.FuelTruck.Vehicle.Name
                                        </td>

                                        <td>
                                            @record.Volume
                                        </td>

                                        <td>
                                            @record.CounterStart
                                            -
                                            @record.CounterEnd
                                        </td>

                                        <td>
                                            @GetUssText(record)
                                        </td>
                                        <td>
                                            @if (record.OmnicommRecord is null)
                                            {
                                                <span>—</span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @record.OmnicommRecord.VolumeLiters.ToString("0.###")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>

<VehicleSelectDialog Visible="@_showVehicleDialog"
                     Vehicles="@_vehicles"
                     SelectedVehicleId="@_dialogVehicleId"
                     OnSelected="@OnVehicleSelected"
                     OnClosed="@CloseVehicleDialog" />

@if (!_timeZoneLoaded && string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-info">
        Загрузка...
    </div>
}
@if (_showSyncToast && _lastSyncResult is not null)
{
    <div class="fueling-sync-toast"
         role="status"
         aria-live="polite"
         aria-atomic="true">

        <div class="fueling-sync-toast-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div class="fueling-sync-toast-content">
            <div class="fueling-sync-toast-title">
                Данные Omnicomm обновлены
            </div>

            <div class="fueling-sync-toast-text">
                Заправок:
                <strong>@_lastSyncResult.FuelingRecordsCount</strong>
                · Событий:
                <strong>@_lastSyncResult.OmnicommEventsCount</strong>
                · Создано:
                <strong>@_lastSyncResult.CreatedCount</strong>
                · Обновлено:
                <strong>@_lastSyncResult.UpdatedCount</strong>
            </div>
        </div>

        <button type="button"
                class="fueling-sync-toast-close"
                aria-label="Закрыть"
                @onclick="HideSyncToast">
            <i class="bi bi-x"></i>
        </button>

    </div>
}
@code {

    private DateOnly _fromDate;

    private DateOnly _toDate;

    private Guid? _selectedVehicleId;
    private bool _showVehicleDialog;

    private Guid? _dialogVehicleId;

    private IReadOnlyList<Vehicle> _vehicles = [];

    private IReadOnlyList<FuelingRecord> _records = [];

    private TimeZoneInfo? _userTimeZone;

    private bool _loading;

    private bool _loaded;

    private string? _errorMessage;

    private bool _timeZoneLoaded;

    private bool _syncing;
    private FuelingOmnicommSyncResult? _lastSyncResult;
    private bool _showSyncToast;

    private int _toastVersion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vehicles =
                await VehicleService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить список техники: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _userTimeZone =
                await UserTimeZoneService.GetAsync();

            _timeZoneLoaded = true;

            var userNow =
                TimeZoneInfo.ConvertTime(
                    DateTimeOffset.UtcNow,
                    _userTimeZone);

            var userDate =
                DateOnly.FromDateTime(
                    userNow.DateTime);

            _fromDate = userDate;
            _toDate = userDate;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось определить часовой пояс пользователя: {ex.Message}";

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ShowSyncToastAsync()
    {
        var version = ++_toastVersion;

        _showSyncToast = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(
            TimeSpan.FromSeconds(4));

        if (version != _toastVersion)
            return;

        _showSyncToast = false;

        await InvokeAsync(StateHasChanged);
    }

    private void HideSyncToast()
    {
        _toastVersion++;
        _showSyncToast = false;
    }

    private async Task LoadRecords()
    {
        if (!_timeZoneLoaded || _userTimeZone is null)
        {
            _errorMessage =
                "Часовой пояс пользователя ещё не определён.";

            return;
        }

        if (!_selectedVehicleId.HasValue)
        {
            _errorMessage =
                "Необходимо выбрать технику.";

            return;
        }

        if (_toDate < _fromDate)
        {
            _errorMessage =
                "Дата окончания не может быть раньше даты начала.";

            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            _records =
                await FuelingRecordService.GetByPeriodAsync(
                    _fromDate,
                    _toDate,
                    _userTimeZone,
                    _selectedVehicleId);

            _loaded = true;
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить заправки: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatUserDateTime(
        DateTimeOffset value)
    {
        if (_userTimeZone is null)
            return value.ToString("dd.MM.yyyy HH:mm");

        return TimeZoneInfo.ConvertTime(
                value,
                _userTimeZone)
            .ToString("dd.MM.yyyy HH:mm");
    }


    private static string GetUssText(
        FuelingRecord record)
    {
        if (record.UssRecords is not { Count: > 0 })
            return "—";

        var count =
            record.UssRecords.Count;

        var volume =
            record.UssRecords.Sum(
                x => x.VolumeLiters);

        return count == 1
            ? $"{volume:0.###}"
            : $"{count} записи, {volume:0.###}";
    }

    private async Task SyncOmnicomm()
    {
        if (!_timeZoneLoaded || _userTimeZone is null)
        {
            _errorMessage =
                "Часовой пояс пользователя ещё не определён.";

            return;
        }

        if (!_selectedVehicleId.HasValue)
        {
            _errorMessage =
                "Необходимо выбрать технику.";

            return;
        }

        if (_toDate < _fromDate)
        {
            _errorMessage =
                "Дата окончания не может быть раньше даты начала.";

            return;
        }

        _syncing = true;
        _errorMessage = null;
        _lastSyncResult = null;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var userId =
                authenticationState.User
                    .FindFirstValue(
                        ClaimTypes.NameIdentifier);

            if (!Guid.TryParse(
                    userId,
                    out var matchedBy))
            {
                throw new InvalidOperationException(
                    "Не удалось определить текущего пользователя.");
            }

            _lastSyncResult =
                await OmnicommFuelingSyncService.SyncAsync(
                    _fromDate,
                    _toDate,
                    _selectedVehicleId,
                    _userTimeZone,
                    matchedBy);

            await LoadRecords();
        }
        catch (Exception ex)
        {
            _lastSyncResult = null;

            _errorMessage =
                $"Не удалось обновить данные Omnicomm: {ex.Message}";
        }
        finally
        {
            _syncing = false;
        }

        // Toast запускаем только после завершения операции.
        if (_lastSyncResult is not null &&
            string.IsNullOrWhiteSpace(_errorMessage))
        {
            await ShowSyncToastAsync();
        }
    }

    private void OpenVehicleDialog()
    {
        _dialogVehicleId = _selectedVehicleId;
        _showVehicleDialog = true;
    }

    private void CloseVehicleDialog()
    {
        _showVehicleDialog = false;
    }

    private void OnVehicleSelected(Guid id)
    {
        _selectedVehicleId = id;
        _dialogVehicleId = id;
        _showVehicleDialog = false;
    }

    private string GetSelectedVehicleName()
    {
        if (!_selectedVehicleId.HasValue)
            return string.Empty;

        return _vehicles
                   .FirstOrDefault(x =>
                       x.Id == _selectedVehicleId.Value)
                   ?.Name
               ?? string.Empty;
    }

    private static decimal CalculateDifferencePercent(
        decimal value,
        decimal reference)
    {
        if (reference == 0)
            return 0;

        return (value - reference)
               / reference
               * 100m;
    }

    private decimal GetStatementVolume()
    {
        return _records.Sum(
            x => (decimal)x.Volume);
    }

    private decimal GetUssVolume()
    {
        return _records.Sum(
            x => x.UssRecords.Sum(
                uss => uss.VolumeLiters));
    }

    private decimal GetOmnicommVolume()
    {
        return _records
            .Where(x => x.OmnicommRecord is not null)
            .Sum(x => x.OmnicommRecord!.VolumeLiters);
    }

    private decimal GetStatementVsUssDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetUssVolume(), GetStatementVolume()) * -1;
    }

    private decimal GetStatementVsOmnicommDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetOmnicommVolume(),
            GetStatementVolume()) * -1;
    }

    private decimal GetUssVsStatementDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetUssVolume(),
            GetStatementVolume());
    }

    private decimal GetUssVsOmnicommDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetOmnicommVolume(),
            GetUssVolume()) * -1;
    }

    private decimal GetOmnicommVsStatementDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetOmnicommVolume(),
            GetStatementVolume());
    }

    private decimal GetOmnicommVsUssDifferencePercent()
    {
        return CalculateDifferencePercent(
            GetOmnicommVolume(),
            GetUssVolume());
    }

    private static string FormatVolume(
        decimal volume)
    {
        return $"{volume:N1} л";
    }

    private static string FormatDifference(
        decimal difference)
    {
        if (difference == 0)
            return "0,00%";

        return difference > 0
            ? $"+{difference:N2}%"
            : $"{difference:N2}%";
    }

    private static string GetDifferenceClass(
        decimal difference)
    {
        return Math.Abs(difference) > 2.5m ? "text-danger" : "text-success";
    }
}