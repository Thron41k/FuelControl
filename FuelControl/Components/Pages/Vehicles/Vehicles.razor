@page "/vehicles"
@rendermode InteractiveServer
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Identity
@using FuelControl.Infrastructure.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using FuelControl.Omnicomm.Vehicles.Models

@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Dispatcher}")]

@inject IVehicleService VehicleService
@inject IBranchService BranchService
@inject IOmnicommVehicleImportService OmnicommVehicleImportService

<PageTitle>Техника</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Техника</h1>
            <div class="text-muted">
                Справочник техники
            </div>
        </div>

        <button class="btn btn-primary"
                @onclick="OpenCreateDialog">
            <span class="bi bi-plus-lg me-1"></span>
            Добавить
        </button>
    </div>

    <div class="card shadow-sm">

        <div class="card-body border-bottom">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-5">
                    <label class="form-label">
                        Поиск
                    </label>

                    <input class="form-control"
                           placeholder="Название, госномер, инв. №"
                           @bind="_searchText"
                           @bind:event="oninput" />
                </div>

                <div class="col-12 col-lg-3">
                    <label class="form-label">
                        Статус
                    </label>
                    <select class="form-select"
                            value="@_statusFilter"
                            @onchange="OnStatusChanged">
                        <option value="Active">
                            Активные
                        </option>

                        <option value="All">
                            Все
                        </option>

                        <option value="Inactive">
                            Неактивные
                        </option>
                    </select>
                </div>

                <AuthorizeView Roles="@Roles.Admin">
                    <ChildContent>

                        <div class="col-12 col-lg-4">

                            <label class="form-label">
                                Филиал
                            </label>

                            <select class="form-select"
                                    @bind="_selectedBranchId">

                                <option value="">
                                    Все филиалы
                                </option>

                                @foreach (var branch in _branches)
                                {
                                    <option value="@branch.Id">
                                        @branch.Name
                                    </option>
                                }

                            </select>

                        </div>

                    </ChildContent>
                </AuthorizeView>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>
                            Филиал
                        </th>

                        <th>
                            Техника
                        </th>

                        <th>
                            Госномер
                        </th>
                        
                        <th>
                            Omnicomm ID
                        </th>

                        <th>
                            Статус
                        </th>

                        <th class="text-end">
                            Действия
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center py-5">

                                <div class="spinner-border"
                                     role="status">

                                    <span class="visually-hidden">
                                        Загрузка...
                                    </span>

                                </div>
                            </td>
                        </tr>
                    }
                    else if (!FilteredVehicles.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-5">

                                Техника не найдена.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var vehicle in FilteredVehicles)
                        {
                            <tr>

                                <td>
                                    @vehicle.Branch.Name
                                </td>

                                <td>
                                    <strong>
                                        @vehicle.Name
                                    </strong>
                                </td>

                                <td>
                                    @vehicle.RegistrationNumber
                                </td>

                                <td>
                                    @vehicle.OmnicommObjectId
                                </td>

                                <td>

                                    @if (vehicle.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            Активна
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Отключена
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="btn-group">

                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenEditDialog(vehicle)">
                                            <span class="bi bi-pencil"></span>
                                            Изменить
                                        </button>

                                        @if (vehicle.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => Deactivate(vehicle)">
                                                <span class="bi bi-power"></span>
                                                Отключить
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success"
                                                    @onclick="() => Activate(vehicle)">
                                                <span class="bi bi-power"></span>
                                                Включить
                                            </button>
                                        }
                                        @if (!vehicle.IsActive)
                                        {
                                            <AuthorizeView Roles="@Roles.Admin">
                                                <ChildContent Context="adminContext">

                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => OpenDeleteDialog(vehicle)">

                                                        <span class="bi bi-trash"></span>
                                                        Удалить

                                                    </button>

                                                </ChildContent>
                                            </AuthorizeView>
                                        }
                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@if (_showDialog)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(_editingVehicle is null
                                            ? "Добавление техники"
                                            : "Редактирование техники")
                </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDialog">
                    </button>

                </div>

                <EditForm Model="_editModel"
                          OnValidSubmit="SaveVehicle">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="alert alert-danger">
                                @_errorMessage
                            </div>
                        }
                        @if (_showOmnicommImport)
                        {
                            <div class="card border-primary mb-4">

                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                                    <span>
                                        <span class="bi bi-cloud-download me-1"></span>
                                        Импорт техники из Omnicomm
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-light"
                                            @onclick="CloseOmnicommImport">

                                        Закрыть

                                    </button>

                                </div>

                                <div class="card-body">

                                    @if (_isImporting)
                                    {
                                        <div class="text-center py-4">

                                            <div class="spinner-border"
                                                 role="status">

                                                <span class="visually-hidden">
                                                    Загрузка...
                                                </span>

                                            </div>

                                            <div class="mt-2 text-muted">
                                                Получение техники из Omnicomm...
                                            </div>

                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_omnicommImportError))
                                    {
                                        <div class="alert alert-danger mb-0">

                                            <span class="bi bi-exclamation-triangle me-1"></span>

                                            @_omnicommImportError

                                        </div>
                                    }
                                    else if (_omnicommGroups.Count == 0)
                                    {
                                        <div class="alert alert-warning mb-0">

                                            Техника из Omnicomm не найдена.

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">

                                            <div class="col-12 col-lg-4">

                                                <label class="form-label fw-semibold">
                                                    Группа
                                                </label>

                                                <div class="list-group"
                                                     style="height: 354px; overflow-y: auto;">

                                                    @foreach (var group in _omnicommGroups)
                                                    {
                                                        var isSelected =
                                                            _selectedOmnicommGroupId == group.Id;

                                                        <button type="button"
                                                                class="list-group-item list-group-item-action @(isSelected ? "active" : "")"
                                                                @onclick="() => SelectOmnicommGroup(group.Id)">

                                                            <div class="d-flex justify-content-between align-items-center">

                                                                <span>
                                                                    @group.Name
                                                                </span>

                                                                <span class="badge @(isSelected ? "text-bg-light" : "text-bg-secondary")">
                                                                    @GetGroupObjectCount(group.Id)
                                                                </span>

                                                            </div>

                                                        </button>
                                                    }

                                                </div>

                                            </div>

                                            <div class="col-12 col-lg-8">

                                                <label class="form-label fw-semibold">
                                                    Техника
                                                </label>

                                                @if (_selectedOmnicommGroupId is null)
                                                {
                                                    <div class="alert alert-light border">
                                                        Выберите группу.
                                                    </div>
                                                }
                                                else
                                                {
                                                    var groupObjects =
                                                        GetObjectsForGroup(
                                                            _selectedOmnicommGroupId.Value);

                                                    @if (!groupObjects.Any())
                                                    {
                                                        <div class="alert alert-warning">
                                                            В выбранной группе нет техники.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-12 col-md-7">
                                                                <input class="form-control"
                                                                       placeholder="Поиск ..."
                                                                       @bind="_omnicommSearchText"
                                                                       @bind:event="oninput" />

                                                            </div>

                                                        </div>
                                                        <div class="list-group"
                                                             style="height: 300px; overflow-y: auto;">

                                                            @foreach (var vehicleObject in FilteredOmnicommObjectsForGroup(_selectedOmnicommGroupId.Value))
                                                            {
                                                                <button type="button"
                                                                        class="list-group-item list-group-item-action" disabled=@vehicleObject.IsAlreadyAdded
                                                                        @onclick="() => SelectOmnicommObject(vehicleObject)">

                                                                    <div class="d-flex justify-content-between">

                                                                        <span>
                                                                            @vehicleObject.Name
                                                                        </span>

                                                                        <small class="text-muted">
                                                                            @vehicleObject.Id
                                                                        </small>

                                                                    </div>

                                                                </button>
                                                            }

                                                        </div>
                                                    }
                                                }

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>
                        }
                        <div class="mb-3">

                            <label class="form-label">
                                Техника
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="_editModel.Name" />

                            <ValidationMessage For="() => _editModel.Name" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Госномер
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="_editModel.RegistrationNumber" />

                            <ValidationMessage For="() => _editModel.RegistrationNumber" />

                        </div>
                        
                        

                        <AuthorizeView Roles="@Roles.Admin">
                            <ChildContent Context="adminContext">
                                
                                <div class="mb-3">

                                    <label class="form-label">
                                        Omnicomm ID
                                    </label>

                                    <InputNumber class="form-control"
                                               @bind-Value="_editModel.OmnicommObjectId" />


                                </div>

                                <div class="mb-3">

                                    <label class="form-label">
                                        Филиал
                                    </label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="_editModel.BranchId">

                                        <option value="">
                                            Выберите филиал
                                        </option>

                                        @foreach (var branch in _branches)
                                        {
                                            <option value="@branch.Id">
                                                @branch.Name
                                            </option>
                                        }

                                    </InputSelect>

                                    <ValidationMessage
                                        For="() => _editModel.BranchId" />

                                </div>

                            </ChildContent>
                        </AuthorizeView>

                    </div>

                    <div class="modal-footer">
                        @if (_editingVehicle is null)
                        {
                            <button type="button"
                                    class="btn btn-outline-primary me-auto"
                                    @onclick="ImportFromOmnicomm"
                                    disabled="@_isImporting">

                                @if (_isImporting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"
                                          role="status">
                                    </span>
                                }
                                else
                                {
                                    <span class="bi bi-cloud-download me-1">Импортировать из Omnicomm</span>
                                }

                            </button>
                        }
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CloseDialog">
                            Отмена
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@_isSaving">

                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }

                            Сохранить

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}

@if (_showDeleteDialog && _vehicleToDelete is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Удаление техники
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDeleteDialog"
                            disabled="@_isDeleting">
                    </button>

                </div>


                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger">
                            @_errorMessage
                        </div>
                    }

                    <p>
                        Вы действительно хотите удалить технику?
                    </p>

                    <div class="border rounded p-3 bg-light">

                        <div class="fw-semibold">
                            @_vehicleToDelete.Name
                        </div>

                        <div class="text-muted">
                            Госномер:
                            @_vehicleToDelete.RegistrationNumber
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                            _vehicleToDelete.InventoryNumber))
                        {
                            <div class="text-muted">
                                Инвентарный №:
                                @_vehicleToDelete.InventoryNumber
                            </div>
                        }

                    </div>

                    <div class="alert alert-warning mt-3 mb-0">

                        <span class="bi bi-exclamation-triangle me-1"></span>

                        Внимание! Удаление необратимо.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDeleteDialog"
                            disabled="@_isDeleting">

                        Отмена

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDeleteVehicle"
                            disabled="@_isDeleting">

                        @if (_isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"
                                  role="status">
                            </span>
                        }
                        else
                        {
                            <span class="bi bi-trash me-1">Удалить</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}
@code {
    private string _omnicommSearchText = string.Empty;

    private bool _showOmnicommImport;

    private bool _isImporting;

    private string? _omnicommImportError;

    private OmnicommWantedListResponse? _omnicommImportResult;

    private IReadOnlyList<OmnicommGroup> _omnicommGroups = [];

    private IReadOnlyList<OmnicommObject> _omnicommObjects = [];

    private long? _selectedOmnicommGroupId;
    private bool _showDeleteDialog;

    private Vehicle? _vehicleToDelete;

    private bool _isDeleting;
    private IReadOnlyList<Vehicle> _vehicleList = [];
    private IReadOnlyList<Branch> _branches = [];

    private bool _isLoading;
    private bool _isSaving;

    private string _searchText = string.Empty;

    private string _statusFilter = "Active";

    private Guid? _selectedBranchId;

    private bool _showDialog;

    private Vehicle? _editingVehicle;

    private string? _errorMessage;

    private VehicleEditModel _editModel = new();

    private IEnumerable<OmnicommObject> FilteredOmnicommObjects =>
        _omnicommObjects
            .Where(MatchesOmnicommSearch)
            .OrderBy(x => x.Name);

    private IEnumerable<Vehicle> FilteredVehicles =>
        _vehicleList
            .Where(MatchesSearch)
            .Where(MatchesStatus)
            .Where(MatchesBranch);

    private bool MatchesOmnicommSearch(OmnicommObject vehicle)
    {
        if (string.IsNullOrWhiteSpace(_omnicommSearchText))
        {
            return true;
        }

        var searchText = _omnicommSearchText.Trim();

        return vehicle.Name.Contains(
                   searchText,
                   StringComparison.OrdinalIgnoreCase)
               ||
               vehicle.Id.ToString().Contains(
                   searchText,
                   StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<OmnicommObject> FilteredOmnicommObjectsForGroup(
        long groupId)
    {
        var group = _omnicommGroups.FirstOrDefault(
            x => x.Id == groupId);

        if (group is null)
        {
            return [];
        }

        var objectIds = group.ObjectIds.ToHashSet();

        return FilteredOmnicommObjects
            .Where(x => objectIds.Contains(x.Id));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBranchesAsync();
        await LoadVehiclesAsync();
    }

    private async Task ImportFromOmnicomm()
    {
        if (_editingVehicle is not null)
        {
            return;
        }

        _isImporting = true;
        _omnicommImportError = null;

        _showOmnicommImport = true;

        try
        {
            _omnicommImportResult =
                await OmnicommVehicleImportService.ImportAsync();

            _omnicommGroups =
                _omnicommImportResult.Groups
                    .OrderBy(x => x.Name)
                    .ToArray();

            _omnicommObjects =
                _omnicommImportResult.Objects
                    .OrderBy(x => x.Name)
                    .ToArray();

            _selectedOmnicommGroupId = null;
        }
        catch (Exception ex)
        {
            _omnicommImportError =
                $"Не удалось получить технику из Omnicomm: {ex.Message}";

            _omnicommImportResult = null;

            _omnicommGroups = [];

            _omnicommObjects = [];
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void CloseOmnicommImport()
    {
        _showOmnicommImport = false;

        _omnicommImportError = null;

        _selectedOmnicommGroupId = null;
    }

    private IEnumerable<OmnicommObject> GetObjectsForGroup(
        long groupId)
    {
        var group =
            _omnicommGroups.FirstOrDefault(
                x => x.Id == groupId);

        if (group is null)
        {
            return [];
        }

        var objectIds =
            group.ObjectIds.ToHashSet();

        return _omnicommObjects
            .Where(x => objectIds.Contains(x.Id))
            .OrderBy(x => x.Name);
    }

    private int GetGroupObjectCount(long groupId)
    {
        var group =
            _omnicommGroups.FirstOrDefault(
                x => x.Id == groupId);

        if (group is null)
        {
            return 0;
        }

        return group.ObjectIds.Count;
    }

    private void SelectOmnicommObject(
        OmnicommObject vehicleObject)
    {
        _editModel.Name = vehicleObject.Name;

        _editModel.RegistrationNumber = string.Empty;
        _editModel.OmnicommObjectId = vehicleObject.Id;

        var group =
            _omnicommGroups.FirstOrDefault(
                x => x.Id == _selectedOmnicommGroupId);

        if (group is not null)
        {
            var branch =
                _branches.FirstOrDefault(
                    x => x.OmnicommId == group.Id);

            if (branch is not null)
            {
                _editModel.BranchId = branch.Id;
            }
        }

        _showOmnicommImport = false;

        _selectedOmnicommGroupId = null;
    }

    private void SelectOmnicommGroup(long groupId)
    {
        _selectedOmnicommGroupId = groupId;
    }

    private async Task LoadBranchesAsync()
    {
        _branches = await BranchService.GetAllAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        _isLoading = true;

        try
        {
            var includeInactive = _statusFilter != "Active";

            _vehicleList = await VehicleService.GetAllAsync(
                includeInactive);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool MatchesSearch(Vehicle vehicle)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var search = _searchText.Trim();

        return vehicle.Name.Contains(
                   search,
                   StringComparison.OrdinalIgnoreCase)
               || vehicle.RegistrationNumber.Contains(
                   search,
                   StringComparison.OrdinalIgnoreCase)
               || (vehicle.InventoryNumber?.Contains(
                       search,
                       StringComparison.OrdinalIgnoreCase)
                   ?? false);
    }

    private bool MatchesStatus(Vehicle vehicle)
    {
        return _statusFilter switch
        {
            "Active" => vehicle.IsActive,
            "Inactive" => !vehicle.IsActive,
            _ => true
        };
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "Active";

        await LoadVehiclesAsync();
    }

    private bool MatchesBranch(Vehicle vehicle)
    {
        if (_selectedBranchId is null)
        {
            return true;
        }

        return vehicle.BranchId == _selectedBranchId.Value;
    }
    private void OpenDeleteDialog(Vehicle vehicle)
    {
        _vehicleToDelete = vehicle;
        _errorMessage = null;
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        if (_isDeleting)
        {
            return;
        }

        _showDeleteDialog = false;
        _vehicleToDelete = null;
        _errorMessage = null;
    }

    private async Task ConfirmDeleteVehicle()
    {
        if (_vehicleToDelete is null)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await VehicleService.DeleteAsync(
                _vehicleToDelete.Id);

            _showDeleteDialog = false;
            _vehicleToDelete = null;

            await LoadVehiclesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }
    private void OpenCreateDialog()
    {
        _editingVehicle = null;

        _errorMessage = null;

        _omnicommImportError = null;

        _showOmnicommImport = false;

        _isImporting = false;

        _omnicommImportResult = null;

        _omnicommGroups = [];

        _omnicommObjects = [];

        _selectedOmnicommGroupId = null;

        _editModel = new VehicleEditModel();

        _showDialog = true;
    }

    private void OpenEditDialog(Vehicle vehicle)
    {
        _editingVehicle = vehicle;

        _errorMessage = null;

        _showOmnicommImport = false;

        _omnicommImportError = null;

        _omnicommImportResult = null;

        _omnicommGroups = [];

        _omnicommObjects = [];

        _selectedOmnicommGroupId = null;

        _editModel = new VehicleEditModel
        {
            Name = vehicle.Name,
            RegistrationNumber = vehicle.RegistrationNumber,
            InventoryNumber = vehicle.InventoryNumber,
            BranchId = vehicle.BranchId,
            OmnicommObjectId = vehicle.OmnicommObjectId
        };

        _showDialog = true;
    }

    private void CloseDialog()
    {
        _showDialog = false;

        _editingVehicle = null;

        _errorMessage = null;

        _showOmnicommImport = false;

        _omnicommImportError = null;

        _omnicommImportResult = null;

        _omnicommGroups = [];

        _omnicommObjects = [];

        _selectedOmnicommGroupId = null;
    }

    private async Task SaveVehicle()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_editingVehicle is null)
            {
                await VehicleService.CreateAsync(
                    _editModel.Name,
                    _editModel.RegistrationNumber,
                    _editModel.BranchId,
                    _editModel.InventoryNumber,
                    _editModel.OmnicommObjectId);
            }
            else
            {
                await VehicleService.UpdateAsync(
                    _editingVehicle.Id,
                    _editModel.Name,
                    _editModel.RegistrationNumber,
                    _editModel.BranchId,
                    _editModel.InventoryNumber,
                    _editModel.OmnicommObjectId);
            }

            CloseDialog();

            await LoadVehiclesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task Deactivate(Vehicle vehicle)
    {
        try
        {
            await VehicleService.SetActiveAsync(
                vehicle.Id,
                false);

            await LoadVehiclesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task Activate(Vehicle vehicle)
    {
        try
        {
            await VehicleService.SetActiveAsync(
                vehicle.Id,
                true);

            await LoadVehiclesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class VehicleEditModel
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Введите название техники.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Введите госномер.")]
        [System.ComponentModel.DataAnnotations.MaxLength(50)]
        public string RegistrationNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(50)]
        public string? InventoryNumber { get; set; }

        public Guid? BranchId { get; set; }
        public long? OmnicommObjectId { get; set; } = null;
    }
}