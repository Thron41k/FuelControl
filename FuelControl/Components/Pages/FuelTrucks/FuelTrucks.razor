@page "/fuel-trucks"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using FuelControl.Components.Pages.FuelingRecord.Dialogs
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Identity
@using FuelControl.Infrastructure.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IFuelTruckService FuelTruckVehicleService
@inject IVehicleService VehicleService

<PageTitle>Топливозаправщики</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="mb-1">
                Топливозаправщики
            </h3>

            <div class="text-muted">
                Техника, назначенная топливозаправщиками
            </div>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="OpenCreateDialog">

            <span class="bi bi-plus-lg me-1"></span>

            Добавить

        </button>

    </div>


    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @ErrorMessage

            <button type="button"
                    class="btn-close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    <div class="card">

        <div class="card-body">

            <div class="mb-3">

                <label class="form-label">
                    Поиск
                </label>

                <input type="search"
                       class="form-control"
                       placeholder="Название, госномер или OmnicommId..."
                       @bind="SearchText"
                       @bind:event="oninput" />

            </div>


            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">

                    <div class="spinner-border"
                         role="status">

                        <span class="visually-hidden">
                            Загрузка...
                        </span>

                    </div>

                </div>
            }
            else if (!FilteredFuelTrucks.Any())
            {
                <div class="text-center text-muted py-5">

                    @if (string.IsNullOrWhiteSpace(SearchText))
                    {
                        <div>
                            Топливозаправщики отсутствуют.
                        </div>
                    }
                    else
                    {
                        <div>
                            По запросу «@SearchText» ничего не найдено.
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>

                                <th>
                                    Техника
                                </th>

                                <th>
                                    Госномер
                                </th>

                                <th>
                                    Емкость Omnicomm
                                </th>

                                <th>
                                    УСС Omnicomm
                                </th>

                                <th>
                                    Филиал
                                </th>

                                <th class="text-end">
                                    Действия
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var fuelTruck in FilteredFuelTrucks)
                            {
                                <tr>

                                    <td>
                                        @fuelTruck.Vehicle.Name
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            fuelTruck.Vehicle.RegistrationNumber)
                                            ? "—"
                                            : fuelTruck.Vehicle.RegistrationNumber)
                                    </td>

                                    <td>
                                        @if (fuelTruck.TankVehicle?.OmnicommObjectId
                                            is { } tankOmnicommId)
                                        {
                                            <div class="fw-semibold">
                                                @tankOmnicommId
                                            </div>

                                            <div class="small text-muted">
                                                @fuelTruck.TankVehicle.Name
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (fuelTruck.UssVehicle?.OmnicommObjectId
                                            is { } ussOmnicommId)
                                        {
                                            <div class="fw-semibold">
                                                @ussOmnicommId
                                            </div>

                                            <div class="small text-muted">
                                                @fuelTruck.UssVehicle.Name
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(fuelTruck.Vehicle.Branch?.Name ?? "—")
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenOmnicommSettings(fuelTruck)">

                                                <span class="bi bi-gear"></span>
                                                Настроить

                                            </button>

                                            <AuthorizeView Roles="@Roles.Admin">

                                                <ChildContent Context="adminContext">

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => ConfirmDelete(fuelTruck.Id)">

                                                        <span class="bi bi-trash"></span>
                                                        Удалить

                                                    </button>

                                                </ChildContent>

                                            </AuthorizeView>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


@* ================================================================
   Диалог добавления / редактирования АТЗ
   ================================================================ *@

@if (ShowDialog)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered fuel-truck-modal">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(EditingFuelTruckId is null
                            ? "Добавление топливозаправщика"
                            : "Редактирование топливозаправщика")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDialog"
                            disabled="@IsSaving">
                    </button>

                </div>


                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(DialogErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @DialogErrorMessage
                        </div>
                    }


                    <div class="mb-3">

                        <label class="form-label">
                            Техника
                        </label>

                        <input type="search"
                               class="form-control mb-3"
                               placeholder="Поиск по названию, госномеру или OmnicommId..."
                               @bind="VehicleSearchText"
                               @bind:event="oninput"
                               disabled="@IsSaving" />

                        <div class="small text-muted mb-2">
                            Найдено: @FilteredAvailableVehicles.Count()
                        </div>

                        <div class="table-responsive border rounded"
                             style="max-height: 450px; overflow-y: auto;">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light"
                                       style="position: sticky; top: 0; z-index: 1;">

                                    <tr>

                                        <th style="width: 35px;"></th>

                                        <th style="width: 35%;">
                                            Техника
                                        </th>

                                        <th style="width: 20%;">
                                            Госномер
                                        </th>

                                        <th style="width: 20%;">
                                            OmnicommId
                                        </th>

                                        <th style="width: 25%;">
                                            Филиал
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var vehicle in FilteredAvailableVehicles)
                                    {
                                        <tr class="@(SelectedVehicleId == vehicle.Id
                                                       ? "table-primary"
                                                       : "")"
                                            style="cursor: pointer;"
                                            @onclick="() => SelectVehicle(vehicle)"
                                            @ondblclick="() => SelectVehicleAndSave(vehicle)">

                                            <td>

                                                @if (SelectedVehicleId == vehicle.Id)
                                                {
                                                    <span class="bi bi-check-circle-fill text-primary">
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="bi bi-circle text-muted">
                                                    </span>
                                                }

                                            </td>

                                            <td>
                                                <div class="fw-semibold">
                                                    @vehicle.Name
                                                </div>
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(
                                                    vehicle.RegistrationNumber)
                                                    ? "—"
                                                    : vehicle.RegistrationNumber)
                                            </td>

                                            <td>
                                                @(vehicle.OmnicommObjectId?.ToString() ?? "—")
                                            </td>

                                            <td>
                                                @(vehicle.Branch?.Name ?? "—")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        @if (!FilteredAvailableVehicles.Any())
                        {
                            <div class="text-center text-muted py-4">
                                Техника не найдена.
                            </div>
                        }

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CloseDialog"
                                disabled="@IsSaving">

                            Отмена

                        </button>


                        <button type="button"
                                class="btn btn-primary"
                                @onclick="SaveFuelTruck"
                                disabled="@(!CanSave)">

                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"
                                      role="status">
                                </span>
                            }

                            Сохранить

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}


@* ================================================================
   Диалог настройки Omnicomm
   ================================================================ *@

@if (ShowOmnicommSettings)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Настройка Omnicomm
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseOmnicommSettings"
                            disabled="@IsSavingOmnicomm">
                    </button>

                </div>


                <div class="modal-body">

                    @if (_editingFuelTruck is not null)
                    {
                        <div class="mb-3">

                            <div class="text-muted small">
                                Топливозаправщик
                            </div>

                            <div class="fw-semibold">
                                @_editingFuelTruck.Vehicle.Name
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                _editingFuelTruck.Vehicle.RegistrationNumber))
                            {
                                <div class="small text-muted">
                                    @_editingFuelTruck.Vehicle.RegistrationNumber
                                </div>
                            }

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        OmnicommSettingsErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @OmnicommSettingsErrorMessage
                        </div>
                    }


                    @* ------------------------------------------------
                       Емкость
                       ------------------------------------------------ *@

                    <div class="mb-4">

                        <label class="form-label">
                            Емкость Omnicomm
                        </label>

                        <div class="input-group">

                            <input class="form-control"
                                   readonly
                                   value="@GetVehicleDisplay(_tankVehicleId)"
                                   placeholder="Не назначена" />

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="() => OpenVehicleSelection(
                                        OmnicommSelectionType.Tank)"
                                    disabled="@IsSavingOmnicomm">

                                <span class="bi bi-search me-1"></span>
                                Выбрать

                            </button>

                        </div>

                        @if (_tankVehicleId.HasValue)
                        {
                            <div class="form-text">
                                OmnicommId:
                                <strong>
                                    @GetOmnicommId(_tankVehicleId)
                                </strong>
                            </div>
                        }

                    </div>


                    @* ------------------------------------------------
                       УСС
                       ------------------------------------------------ *@

                    <div>

                        <label class="form-label">
                            УСС Omnicomm
                        </label>

                        <div class="input-group">

                            <input class="form-control"
                                   readonly
                                   value="@GetVehicleDisplay(_ussVehicleId)"
                                   placeholder="Не назначена" />

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="() => OpenVehicleSelection(
                                        OmnicommSelectionType.Uss)"
                                    disabled="@IsSavingOmnicomm">

                                <span class="bi bi-search me-1"></span>
                                Выбрать

                            </button>

                        </div>

                        @if (_ussVehicleId.HasValue)
                        {
                            <div class="form-text">
                                OmnicommId:
                                <strong>
                                    @GetOmnicommId(_ussVehicleId)
                                </strong>
                            </div>
                        }

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseOmnicommSettings"
                            disabled="@IsSavingOmnicomm">

                        Отмена

                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveOmnicommSettings"
                            disabled="@IsSavingOmnicomm">

                        @if (IsSavingOmnicomm)
                        {
                            <span class="spinner-border spinner-border-sm me-1">
                            </span>
                        }

                        Сохранить

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@* ================================================================
   Существующий VehicleSelectDialog
   ================================================================ *@

<VehicleSelectDialog
    Visible="@ShowVehicleSelectionDialog"
    Vehicles="@OmnicommVehicles"
    SelectedVehicleId="@GetCurrentSelectionId()"
    OnSelected="@OnVehicleSelected"
    OnClosed="@CloseVehicleSelection" />


@* ================================================================
   Диалог удаления
   ================================================================ *@

@if (FuelTruckToDelete is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Удаление топливозаправщика
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelDelete"
                            disabled="@IsDeleting">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        Вы действительно хотите убрать технику
                        <strong>
                            @FuelTruckToDelete.Vehicle.Name
                        </strong>
                        из списка топливозаправщиков?
                    </p>

                    <p class="text-muted mb-0">
                        Сама техника удалена не будет.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelDelete"
                            disabled="@IsDeleting">

                        Отмена

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="DeleteFuelTruck"
                            disabled="@IsDeleting">

                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"
                                  role="status">
                            </span>
                        }

                        Удалить

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code
{
    private string VehicleSearchText = string.Empty;

    private IEnumerable<Vehicle> FilteredAvailableVehicles =>
        AvailableVehicles
            .Where(MatchesVehicleSearch)
            .OrderBy(x => x.Name);

    private IReadOnlyList<FuelTruck> FuelTruckList = [];

    private IReadOnlyList<Vehicle> AvailableVehicles = [];

    private IReadOnlyList<Vehicle> OmnicommVehicles = [];

    private string SearchText = string.Empty;

    private Guid? SelectedVehicleId;

    private Guid? EditingFuelTruckId;

    private FuelTruck? FuelTruckToDelete;

    private FuelTruck? _editingFuelTruck;

    private Guid? _ussVehicleId;

    private Guid? _tankVehicleId;

    private bool IsLoading;

    private bool IsSaving;

    private bool IsDeleting;

    private bool ShowDialog;

    private bool ShowOmnicommSettings;

    private bool ShowVehicleSelectionDialog;

    private bool IsSavingOmnicomm;

    private OmnicommSelectionType _selectionType;

    private string? ErrorMessage;

    private string? DialogErrorMessage;

    private string? OmnicommSettingsErrorMessage;


    private bool CanSave =>
        !IsSaving &&
        SelectedVehicleId.HasValue;


    private IEnumerable<FuelTruck> FilteredFuelTrucks =>
        FuelTruckList
            .Where(MatchesSearch)
            .OrderBy(x => x.Vehicle.Name);


    private enum OmnicommSelectionType
    {
        Uss,
        Tank
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadFuelTrucksAsync();
    }


    private async Task LoadFuelTrucksAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            FuelTruckList =
                await FuelTruckVehicleService
                    .GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task SelectVehicleAndSave(
        Vehicle vehicle)
    {
        if (IsSaving)
        {
            return;
        }

        SelectedVehicleId = vehicle.Id;

        await SaveFuelTruck();
    }


    private bool MatchesVehicleSearch(
        Vehicle vehicle)
    {
        if (string.IsNullOrWhiteSpace(
                VehicleSearchText))
        {
            return true;
        }

        var search =
            VehicleSearchText.Trim();

        return
            vehicle.Name.Contains(
                search,
                StringComparison.OrdinalIgnoreCase)
            ||
            (
                vehicle.RegistrationNumber?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ?? false
            )
            ||
            (
                vehicle.OmnicommObjectId?
                    .ToString()
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                ?? false
            );
    }


    private void SelectVehicle(
        Vehicle vehicle)
    {
        SelectedVehicleId = vehicle.Id;
    }


    private bool MatchesSearch(
        FuelTruck fuelTruck)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return true;
        }

        var search =
            SearchText.Trim();

        return
            fuelTruck.Vehicle.Name.Contains(
                search,
                StringComparison.OrdinalIgnoreCase)
            ||
            (
                fuelTruck.Vehicle.RegistrationNumber
                    ?.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                ?? false
            )
            ||
            (
                fuelTruck.Vehicle.OmnicommObjectId
                    ?.ToString()
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                ?? false
            )
            ||
            (
                fuelTruck.UssVehicle?.OmnicommObjectId
                    ?.ToString()
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                ?? false
            )
            ||
            (
                fuelTruck.TankVehicle?.OmnicommObjectId
                    ?.ToString()
                    .Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                ?? false
            );
    }


    private async Task OpenCreateDialog()
    {
        EditingFuelTruckId = null;

        SelectedVehicleId = null;

        VehicleSearchText = string.Empty;

        DialogErrorMessage = null;

        try
        {
            AvailableVehicles =
                await FuelTruckVehicleService
                    .GetAvailableVehiclesAsync();

            ShowDialog = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }


    private async Task EditFuelTruck(
        Guid id)
    {
        var fuelTruck =
            FuelTruckList
                .FirstOrDefault(x => x.Id == id);

        if (fuelTruck is null)
        {
            return;
        }

        EditingFuelTruckId =
            fuelTruck.Id;

        SelectedVehicleId =
            fuelTruck.VehicleId;

        VehicleSearchText =
            string.Empty;

        DialogErrorMessage =
            null;

        try
        {
            AvailableVehicles =
                await FuelTruckVehicleService
                    .GetAvailableVehiclesAsync();

            // При редактировании текущая техника
            // должна остаться доступной.
            if (AvailableVehicles.All(
                    x => x.Id != fuelTruck.VehicleId))
            {
                AvailableVehicles =
                    AvailableVehicles
                        .Append(fuelTruck.Vehicle)
                        .OrderBy(x => x.Name)
                        .ToList();
            }

            ShowDialog = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }


    private void CloseDialog()
    {
        if (IsSaving)
        {
            return;
        }

        ShowDialog = false;

        EditingFuelTruckId = null;
        SelectedVehicleId = null;

        VehicleSearchText =
            string.Empty;

        AvailableVehicles = [];

        DialogErrorMessage = null;
    }


    private async Task SaveFuelTruck()
    {
        if (SelectedVehicleId is null)
        {
            DialogErrorMessage =
                "Выберите технику.";

            return;
        }

        IsSaving = true;
        DialogErrorMessage = null;

        try
        {
            if (EditingFuelTruckId is null)
            {
                await FuelTruckVehicleService
                    .CreateAsync(
                        SelectedVehicleId.Value);
            }
            else
            {
                await FuelTruckVehicleService
                    .UpdateAsync(
                        EditingFuelTruckId.Value,
                        SelectedVehicleId.Value);
            }

            ShowDialog = false;

            EditingFuelTruckId = null;
            SelectedVehicleId = null;

            AvailableVehicles = [];

            await LoadFuelTrucksAsync();
        }
        catch (Exception ex)
        {
            DialogErrorMessage =
                ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private async Task OpenOmnicommSettings(
        FuelTruck fuelTruck)
    {
        _editingFuelTruck =
            fuelTruck;

        _ussVehicleId =
            fuelTruck.UssVehicleId;

        _tankVehicleId =
            fuelTruck.TankVehicleId;

        OmnicommSettingsErrorMessage =
            null;

        try
        {
            var vehicles =
                await VehicleService.GetAllAsync();

            OmnicommVehicles =
                vehicles
                    .Where(x =>
                        x.IsActive &&
                        x.OmnicommObjectId.HasValue)
                    .OrderBy(x => x.Name)
                    .ToList();

            ShowOmnicommSettings = true;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                ex.Message;
        }
    }


    private void CloseOmnicommSettings()
    {
        if (IsSavingOmnicomm)
        {
            return;
        }

        ShowOmnicommSettings = false;

        _editingFuelTruck = null;

        _ussVehicleId = null;
        _tankVehicleId = null;

        OmnicommVehicles = [];

        OmnicommSettingsErrorMessage = null;
    }


    private void OpenVehicleSelection(
        OmnicommSelectionType selectionType)
    {
        _selectionType =
            selectionType;

        ShowVehicleSelectionDialog = true;
    }


    private Guid? GetCurrentSelectionId()
    {
        return _selectionType switch
        {
            OmnicommSelectionType.Uss =>
                _ussVehicleId,

            OmnicommSelectionType.Tank =>
                _tankVehicleId,

            _ => null
        };
    }


    private void OnVehicleSelected(
        Guid vehicleId)
    {
        switch (_selectionType)
        {
            case OmnicommSelectionType.Uss:
                _ussVehicleId =
                    vehicleId;
                break;

            case OmnicommSelectionType.Tank:
                _tankVehicleId =
                    vehicleId;
                break;
        }

        ShowVehicleSelectionDialog = false;
    }


    private void CloseVehicleSelection()
    {
        ShowVehicleSelectionDialog = false;
    }


    private async Task SaveOmnicommSettings()
    {
        if (_editingFuelTruck is null)
        {
            return;
        }

        IsSavingOmnicomm = true;

        OmnicommSettingsErrorMessage =
            null;

        try
        {
            await FuelTruckVehicleService
                .SetOmnicommVehiclesAsync(
                    _editingFuelTruck.Id,
                    _ussVehicleId,
                    _tankVehicleId);

            await LoadFuelTrucksAsync();

            ShowOmnicommSettings = false;

            _editingFuelTruck = null;

            _ussVehicleId = null;
            _tankVehicleId = null;

            OmnicommVehicles = [];
        }
        catch (Exception ex)
        {
            OmnicommSettingsErrorMessage =
                ex.Message;
        }
        finally
        {
            IsSavingOmnicomm = false;
        }
    }


    private string GetVehicleDisplay(
        Guid? vehicleId)
    {
        if (!vehicleId.HasValue)
        {
            return string.Empty;
        }

        return OmnicommVehicles
            .FirstOrDefault(
                x => x.Id == vehicleId.Value)
            ?.Name
            ?? "Техника не найдена";
    }


    private long? GetOmnicommId(
        Guid? vehicleId)
    {
        if (!vehicleId.HasValue)
        {
            return null;
        }

        return OmnicommVehicles
            .FirstOrDefault(
                x => x.Id == vehicleId.Value)
            ?.OmnicommObjectId;
    }


    private void ConfirmDelete(
        Guid id)
    {
        FuelTruckToDelete =
            FuelTruckList
                .FirstOrDefault(
                    x => x.Id == id);
    }


    private void CancelDelete()
    {
        if (IsDeleting)
        {
            return;
        }

        FuelTruckToDelete = null;
    }


    private async Task DeleteFuelTruck()
    {
        if (FuelTruckToDelete is null)
        {
            return;
        }

        var id =
            FuelTruckToDelete.Id;

        IsDeleting = true;
        ErrorMessage = null;

        try
        {
            await FuelTruckVehicleService
                .DeleteAsync(id);

            FuelTruckToDelete = null;

            await LoadFuelTrucksAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                ex.Message;
        }
        finally
        {
            IsDeleting = false;
        }
    }


    private void ClearError()
    {
        ErrorMessage = null;
    }
}