@page "/tools/lld"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using FuelControl.Components.Pages.FuelingRecord.Dialogs
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Identity
@using FuelControl.Infrastructure.Services.Interfaces
@using FuelControl.Omnicomm.Tools.Lld.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IVehicleService VehicleService
@inject IOmnicommLldService OmnicommLldService
@inject IJSRuntime JSRuntime

<PageTitle>LLD таблицы</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">

        <h3 class="mb-1">
            LLD таблицы
        </h3>

        <div class="text-muted">
            Загрузка тарировочной таблицы из профиля техники Omnicomm
        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @_errorMessage

            <button type="button"
                    class="btn-close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-8">

                    <label class="form-label">
                        Техника
                    </label>

                    <div class="input-group">

                        <input class="form-control"
                               readonly
                               value="@GetSelectedVehicleName()"
                               placeholder="Выберите технику" />

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="OpenVehicleDialog">

                            <i class="bi bi-search me-1"></i>

                            Выбрать

                        </button>

                    </div>

                    @if (_selectedVehicleId.HasValue)
                    {
                        var selectedVehicle =
                            _vehicles.FirstOrDefault(
                                x => x.Id == _selectedVehicleId);

                        @if (selectedVehicle?.OmnicommObjectId
                            is { } omnicommObjectId)
                        {
                            <div class="form-text">
                                Omnicomm ID:
                                <strong>
                                    @omnicommObjectId
                                </strong>
                            </div>
                        }
                    }

                </div>


                <div class="col-md-4">

                    <button type="button"
                            class="btn btn-primary w-100"
                            disabled="@(!_selectedVehicleId.HasValue || _loading)"
                            @onclick="LoadLldAsync">

                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2">
                            </span>
                        }

                        Загрузить LLD

                    </button>

                </div>

            </div>

        </div>

    </div>


    @if (_loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 style="width: 3rem; height: 3rem;">
            </div>

            <div class="mt-3 text-muted">
                Получение профиля техники из Omnicomm...
            </div>

        </div>
    }
    else if (_tables.Count > 0)
    {
        @foreach (var table in _tables)
        {
            <div class="card mb-4">

                <div class="card-header">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <strong>
                                Датчик @table.SensorNumber
                            </strong>

                            <span class="text-muted ms-3">
                                Бак @table.TankNumber
                            </span>

                        </div>

                        <div class="text-muted small">
                            Terminal ID:
                            @table.TerminalId
                        </div>

                    </div>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Код ДУТ
                                    </th>

                                    <th>
                                        Объём, л
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var record in table.Records)
                                {
                                    <tr>

                                        <td>
                                            @record.Code
                                        </td>

                                        <td>
                                            @record.Liters.ToString("0.###")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }


        <div class="d-flex justify-content-end">

            <button type="button"
                    class="btn btn-success"
                    @onclick="DownloadCsv">

                <i class="bi bi-download me-1"></i>

                Скачать CSV

            </button>

        </div>
    }
    else if (_loaded)
    {
        <div class="alert alert-warning">
            В профиле выбранной техники LLD таблицы отсутствуют.
        </div>
    }

</div>


<VehicleSelectDialog
    Visible="@_showVehicleDialog"
    Vehicles="@_vehicles"
    SelectedVehicleId="@_selectedVehicleId"
    OnSelected="@OnVehicleSelected"
    OnClosed="@CloseVehicleDialog" />


@code
{
    private IReadOnlyList<Vehicle> _vehicles = [];

    private IReadOnlyList<LldCalibrationTable> _tables = [];

    private Guid? _selectedVehicleId;

    private bool _showVehicleDialog;

    private bool _loading;

    private bool _loaded;

    private string? _errorMessage;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vehicles =
                await VehicleService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить технику: {ex.Message}";
        }
    }


    private void OpenVehicleDialog()
    {
        _showVehicleDialog = true;
    }


    private void CloseVehicleDialog()
    {
        _showVehicleDialog = false;
    }


    private void OnVehicleSelected(
        Guid vehicleId)
    {
        _selectedVehicleId =
            vehicleId;

        _tables = [];

        _loaded = false;

        _showVehicleDialog = false;
    }


    private async Task LoadLldAsync()
    {
        if (_selectedVehicleId is not { } vehicleId)
            return;

        var vehicle =
            _vehicles.FirstOrDefault(
                x => x.Id == vehicleId);

        if (vehicle?.OmnicommObjectId is not { } omnicommObjectId)
        {
            _errorMessage =
                "У выбранной техники не указан OmnicommObjectId.";

            return;
        }

        _loading = true;
        _loaded = false;
        _errorMessage = null;
        _tables = [];

        try
        {
            _tables =
                await OmnicommLldService.GetTablesAsync(
                    omnicommObjectId);
            
            _loaded = true;
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить LLD таблицу: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }


    private string GetSelectedVehicleName()
    {
        if (_selectedVehicleId is not { } vehicleId)
            return string.Empty;

        return _vehicles
                   .FirstOrDefault(
                       x => x.Id == vehicleId)
                   ?.Name
               ?? "Техника не найдена";
    }


    private async Task DownloadCsv()
    {
        if (_tables.Count == 0)
            return;

        var csv =
            BuildCsv();

        var bytes =
            System.Text.Encoding.UTF8
                .GetBytes(csv);

        var base64 =
            Convert.ToBase64String(bytes);

        var fileName =
            BuildFileName();

        await JSRuntime.InvokeVoidAsync(
            "fuelControl.downloadFile",
            fileName,
            "text/csv;charset=utf-8",
            base64);
    }


    private string BuildCsv()
    {
        var builder =
            new System.Text.StringBuilder();

        builder.AppendLine(
            "Датчик;Бак;Terminal ID;Код ДУТ;Объем, л");

        foreach (var table in _tables)
        {
            foreach (var record in table.Records)
            {
                builder.AppendLine(
                    string.Join(
                        ';',
                        table.SensorNumber,
                        table.TankNumber,
                        table.TerminalId,
                        record.Code,
                        record.Liters
                            .ToString(
                                "0.###",
                                System.Globalization.CultureInfo.InvariantCulture)));
            }
        }

        return builder.ToString();
    }


    private string BuildFileName()
    {
        var vehicle =
            _selectedVehicleId is { } id
                ? _vehicles.FirstOrDefault(
                    x => x.Id == id)
                : null;

        var name =
            vehicle?.Name ?? "vehicle";

        foreach (var invalidChar in
                 Path.GetInvalidFileNameChars())
        {
            name =
                name.Replace(
                    invalidChar,
                    '_');
        }

        return $"LLD_{name}.csv";
    }


    private void ClearError()
    {
        _errorMessage = null;
    }
}