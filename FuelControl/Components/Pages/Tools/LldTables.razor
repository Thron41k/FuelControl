@page "/tools/lld"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using System.Globalization
@using System.Text
@using FuelControl.Components.Pages.FuelingRecord.Dialogs
@using FuelControl.Domain.Entities
@using FuelControl.Infrastructure.Identity
@using FuelControl.Infrastructure.Services.Interfaces
@using FuelControl.Omnicomm.Tools.Lld.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IVehicleService VehicleService
@inject IOmnicommLldService OmnicommLldService
@inject IJSRuntime JSRuntime

<PageTitle>LLD таблицы</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">

        <h3 class="mb-1">
            LLD таблицы
        </h3>

        <div class="text-muted">
            Загрузка тарировочной таблицы из профиля техники Omnicomm
        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @_errorMessage

            <button type="button"
                    class="btn-close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-8">

                    <label class="form-label">
                        Техника
                    </label>

                    <div class="input-group">

                        <input class="form-control"
                               readonly
                               value="@GetSelectedVehicleName()"
                               placeholder="Выберите технику" />

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="OpenVehicleDialog">

                            <i class="bi bi-search me-1"></i>
                            Выбрать

                        </button>

                    </div>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        &nbsp;
                    </label>

                    <button type="button"
                            class="btn btn-primary w-100"
                            disabled="@(!_selectedVehicleId.HasValue || _loading)"
                            @onclick="LoadLldAsync">

                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }

                        Загрузить таблицу

                    </button>

                </div>

            </div>

        </div>

    </div>


    @if (_loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 style="width: 3rem; height: 3rem;">
            </div>

            <div class="mt-3 text-muted">
                Получение профиля техники из Omnicomm...
            </div>

        </div>
    }
    else if (_tables.Count > 0)
    {
        @foreach (var table in _tables)
        {
            var isExpanded =
                _expandedTables.Contains(GetTableKey(table));

            <div class="card mb-3">

                <div class="card-header p-0">

                    <div class="d-flex align-items-center">

                        <button type="button"
                                class="btn btn-link text-decoration-none text-start flex-grow-1 px-3 py-3 lld-table-toggle"
                                @onclick="() => ToggleTable(table)">

                            <div class="d-flex align-items-center">

                                <i class="bi @(isExpanded
                                                               ? "bi-chevron-down"
                                                               : "bi-chevron-right") me-3">
                                </i>

                                <div>

                                    <div class="fw-semibold">
                                        Датчик @table.SensorNumber
                                    </div>

                                    <div class="small text-muted">

                                        Бак @table.TankNumber

                                        <span class="mx-2">•</span>

                                        Terminal ID:
                                        @table.TerminalId

                                        <span class="mx-2">•</span>

                                        Точек:
                                        @table.Records.Count

                                    </div>

                                </div>

                            </div>

                        </button>


                        <div class="d-flex align-items-center gap-2" style="margin-right: 10px;">

                            <select class="form-select form-select-sm"
                                    style="width: 180px;"
                                    @bind="_volumeDigitsToRemove">

                                <option value="0">
                                    Без изменений
                                </option>

                                <option value="1">
                                    1000 → 100
                                </option>

                                <option value="2">
                                    1000 → 10
                                </option>

                                <option value="3">
                                    1000 → 1
                                </option>

                            </select>

                            <button type="button"
                                    class="btn btn-sm btn-success"
                                    @onclick="() => DownloadLldAsync(table)"
                                    @onclick:stopPropagation="true">

                                <i class="bi bi-download me-1"></i>

                                Скачать ctb

                            </button>

                        </div>

                    </div>

                </div>


                @if (isExpanded)
                {
                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th>
                                            Объём, л
                                        </th>

                                        <th>
                                            Показание ДУТ
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var record in table.Records)
                                    {
                                        <tr>

                                            <td>
                                                @record.Liters.ToString(
                                                    "0.###")
                                            </td>

                                            <td>
                                                @record.Code
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>
                }

            </div>
        }
    }
    else if (_loaded)
    {
        <div class="alert alert-warning">
            В профиле выбранной техники LLD таблицы отсутствуют.
        </div>
    }

</div>


<VehicleSelectDialog
    Visible="@_showVehicleDialog"
    Vehicles="@_vehicles"
    SelectedVehicleId="@_selectedVehicleId"
    OnSelected="@OnVehicleSelected"
    OnClosed="@CloseVehicleDialog" />


@code
{
    private IReadOnlyList<Vehicle> _vehicles = [];

    private IReadOnlyList<LldCalibrationTable> _tables = [];

    private Guid? _selectedVehicleId;

    private bool _showVehicleDialog;

    private bool _loading;

    private bool _loaded;

    private string? _errorMessage;

    private readonly HashSet<string> _expandedTables = [];

    private int _volumeDigitsToRemove;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vehicles =
                await VehicleService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить технику: {ex.Message}";
        }
    }


    private void OpenVehicleDialog()
    {
        _showVehicleDialog = true;
    }


    private void CloseVehicleDialog()
    {
        _showVehicleDialog = false;
    }


    private void OnVehicleSelected(
        Guid vehicleId)
    {
        _selectedVehicleId =
            vehicleId;

        _tables = [];

        _loaded = false;

        _showVehicleDialog = false;
    }


    private async Task LoadLldAsync()
    {
        if (_selectedVehicleId is not { } vehicleId)
            return;

        var vehicle =
            _vehicles.FirstOrDefault(
                x => x.Id == vehicleId);

        if (vehicle?.OmnicommObjectId is not { } omnicommObjectId)
        {
            _errorMessage =
                "У выбранной техники не указан OmnicommObjectId.";

            return;
        }

        _loading = true;
        _loaded = false;
        _errorMessage = null;
        _tables = [];

        try
        {
            _tables =
                await OmnicommLldService.GetTablesAsync(
                    omnicommObjectId);
            
            _loaded = true;
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"Не удалось загрузить LLD таблицу: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }


    private string GetSelectedVehicleName()
    {
        if (_selectedVehicleId is not { } vehicleId)
            return string.Empty;

        return _vehicles
                   .FirstOrDefault(
                       x => x.Id == vehicleId)
                   ?.Name
               ?? "Техника не найдена";
    }


    private async Task DownloadLldAsync(
        LldCalibrationTable table)
    {
        var content =
            BuildLldFile(
                table,
                _volumeDigitsToRemove);

        var bytes =
            Encoding.UTF8.GetBytes(content);

        var base64 =
            Convert.ToBase64String(bytes);

        var fileName =
            $"LLD_{table.TerminalId}_S{table.SensorNumber}_T{table.TankNumber}.ctb";

        await JSRuntime.InvokeVoidAsync(
            "fuelControl.downloadFile",
            fileName,
            "text/plain;charset=utf-8",
            base64);
    }

    private string BuildLldFile(
        LldCalibrationTable table,
        int digitsToRemove)
    {
        var records =
            table.Records
                .OrderBy(x => x.Liters)
                .ToList();

        if (records.Count == 0)
        {
            throw new InvalidOperationException(
                "LLD таблица не содержит записей.");
        }

        var scale =
            GetVolumeScale(digitsToRemove);

        var step =
            records.Count > 1
                ? (records[1].Liters - records[0].Liters) / scale
                : 0m;

        var builder =
            new StringBuilder();

        builder.AppendLine(
            $"0;{FormatValue(step)};");

        builder.AppendLine(
            table.SensorNumber.ToString(
                CultureInfo.InvariantCulture));

        foreach (var record in records)
        {
            var volume =
                record.Liters / scale;

            builder.AppendLine(
                $"{FormatValue(volume)};" +
                record.Code.ToString(
                    CultureInfo.InvariantCulture));
        }

        return builder.ToString();
    }

    private static decimal GetVolumeScale(
        int digitsToRemove)
    {
        return digitsToRemove switch
        {
            0 => 1m,
            1 => 10m,
            2 => 100m,
            3 => 1000m,

            _ => throw new ArgumentOutOfRangeException(
                nameof(digitsToRemove))
        };
    }

    private static string FormatValue(
        decimal value)
    {
        return Math.Truncate(value).ToString(
            CultureInfo.InvariantCulture);
    }


    private void ClearError()
    {
        _errorMessage = null;
    }

    private static string GetTableKey(
        LldCalibrationTable table)
    {
        return $"{table.TerminalId}:{table.SensorNumber}:{table.TankNumber}:{table.MultiTankNumber}";
    }

    private void ToggleTable(
        LldCalibrationTable table)
    {
        var key =
            GetTableKey(table);

        if (!_expandedTables.Add(key))
        {
            _expandedTables.Remove(key);
        }
    }
}